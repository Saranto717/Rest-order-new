@page "/admin/extras"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory

<h2>Extra / Συστατικά</h2>
<p class="hint">
    Επιλογές που θα βλέπει ο σερβιτόρος πατώντας το κουμπί "Extra" όταν προσθέτει ένα είδος
    (π.χ. για καφέδες: πολύ γλυκός, μέτριος, σκέτος). Αν δεν επιλέξεις κατηγορία, η επιλογή
    εμφανίζεται για όλα τα είδη — μπορείς να την ορίσεις και αργότερα, όπως στα είδη του καταλόγου.
    Για αλλαγή ονόματος ή τιμής ενός extra, πάτησε «Επεξεργασία» στη γραμμή του.
</p>

<h3>Προσθήκη ενός extra</h3>
<div class="admin-form">
    <input @bind="newName" placeholder="π.χ. Μέτριος" />
    <input @bind="newPrice" placeholder="Τιμή (προαιρετικό)" style="width:100px" />
    <select @bind="newCategoryId">
        <option value="0">-- Χωρίς κατηγορία (όλες) --</option>
        @foreach (var c in categories)
        {
            <option value="@c.Id">@(c.IsActive ? c.Name : $"{c.Name} (ανενεργή)")</option>
        }
    </select>
    <button @onclick="Add">Προσθήκη</button>
</div>

<h3>Μαζική προσθήκη πολλών extra</h3>
<p class="hint">
    Ένα extra ανά γραμμή. Προαιρετικά βάλε τιμή μετά από ; (π.χ. <code>Με κρέμα;0.50</code>).
    Η κατηγορία (αν διαλέξεις) εφαρμόζεται σε όλη τη λίστα.
</p>
<div class="admin-form quick-add-form">
    <div class="form-row">
        <label>Κατηγορία (προαιρετικό, εφαρμόζεται σε όλα)</label>
        <select @bind="bulkAddCategoryId">
            <option value="0">-- Χωρίς κατηγορία (όλες) --</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id">@(c.IsActive ? c.Name : $"{c.Name} (ανενεργή)")</option>
            }
        </select>
    </div>
    <div class="form-row">
        <label>Extra (ένα ανά γραμμή)</label>
        <textarea @bind="bulkAddText" rows="6" placeholder="Πολύ γλυκός&#10;Μέτριος&#10;Σκέτος&#10;Με κρέμα;0.50"></textarea>
    </div>
    <button @onclick="BulkAdd">Μαζική προσθήκη</button>
</div>

@if (!string.IsNullOrEmpty(bulkAddMessage))
{
    <p class="success">@bulkAddMessage</p>
}

<h3>Εισαγωγή από Excel</h3>
<p class="hint">
    Ανέβασε ένα αρχείο <code>.xlsx</code> με στήλες: <b>Extra</b> (το όνομα), προαιρετικά
    <b>Κατηγορία</b> (κενό = όλες) και προαιρετικά <b>Τιμή</b>.
</p>
<div class="admin-form">
    <InputFile OnChange="HandleExcelUpload" accept=".xlsx" />
</div>
@if (isImportingExcel)
{
    <p class="hint">Εισαγωγή σε εξέλιξη...</p>
}
@if (!string.IsNullOrEmpty(excelImportMessage))
{
    <p class="success">@excelImportMessage</p>
}

<h3>Όλα τα extra</h3>

@if (items.Count > 0)
{
    <div class="bulk-bar">
        <label><input type="checkbox" checked="@allSelected" @onchange="ToggleSelectAll" /> Επιλογή όλων</label>
        <span>@selectedIds.Count επιλεγμένα</span>
        <select @bind="bulkCategoryId">
            <option value="0">-- Χωρίς κατηγορία (όλες) --</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id">@(c.IsActive ? c.Name : $"{c.Name} (ανενεργή)")</option>
            }
        </select>
        <button @onclick="ApplyBulkCategory" disabled="@(selectedIds.Count == 0)">Ανάθεση κατηγορίας στα επιλεγμένα</button>
        <button class="danger" @onclick="DeleteSelected" disabled="@(selectedIds.Count == 0)">Διαγραφή επιλεγμένων</button>
    </div>
}

<table class="admin-table">
    <thead><tr><th></th><th>Όνομα</th><th>Κατηγορία</th><th>Τιμή</th><th></th></tr></thead>
    <tbody>
        @foreach (var e in items)
        {
            @if (editingId == e.Id)
            {
                <tr>
                    <td></td>
                    <td><input @bind="editName" /></td>
                    <td>
                        <select @bind="editCategoryId">
                            <option value="0">-- Χωρίς κατηγορία (όλες) --</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id">@(c.IsActive ? c.Name : $"{c.Name} (ανενεργή)")</option>
                            }
                        </select>
                    </td>
                    <td><input @bind="editPrice" style="width:70px" /></td>
                    <td>
                        <button @onclick="() => SaveEdit(e)">Αποθήκευση</button>
                        <button @onclick="CancelEdit">Άκυρο</button>
                    </td>
                </tr>
            }
            else
            {
                <tr>
                    <td><input type="checkbox" checked="@selectedIds.Contains(e.Id)" @onchange="ev => ToggleSelect(e.Id, ev)" /></td>
                    <td>@e.Name</td>
                    <td>@(e.MenuCategory?.Name ?? "— όλες —")</td>
                    <td>@(e.Price > 0 ? $"€{e.Price:0.00}" : "—")</td>
                    <td>
                        <button @onclick="() => StartEdit(e)">Επεξεργασία</button>
                        <button class="danger" @onclick="() => Delete(e)">Διαγραφή</button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<ExtraOption> items = new();
    private List<MenuCategory> categories = new();
    private string newName = "";
    private string newPrice = "";
    private int newCategoryId = 0;

    private int bulkAddCategoryId = 0;
    private string bulkAddText = "";
    private string? bulkAddMessage;

    private bool isImportingExcel;
    private string? excelImportMessage;

    private int bulkCategoryId = 0;
    private HashSet<int> selectedIds = new();
    private bool allSelected => items.Count > 0 && selectedIds.Count == items.Count;

    private int? editingId;
    private string editName = "";
    private string editPrice = "";
    private int editCategoryId = 0;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        items = await db.ExtraOptions.Include(e => e.MenuCategory).OrderBy(e => e.Name).ToListAsync();
        categories = await db.MenuCategories.OrderBy(c => c.Name).ToListAsync();
        selectedIds.RemoveWhere(id => items.All(i => i.Id != id));
    }

    private static decimal ParsePrice(string raw)
    {
        decimal.TryParse(raw.Replace(",", "."),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var price);
        return price;
    }

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(newName)) return;
        var price = ParsePrice(newPrice);

        using var db = await DbFactory.CreateDbContextAsync();
        db.ExtraOptions.Add(new ExtraOption
        {
            Name = newName.Trim(),
            Price = price,
            MenuCategoryId = newCategoryId == 0 ? null : newCategoryId
        });
        await db.SaveChangesAsync();
        newName = ""; newPrice = ""; newCategoryId = 0;
        await Load();
    }

    private async Task BulkAdd()
    {
        bulkAddMessage = null;
        var lines = bulkAddText.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (lines.Length == 0) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var count = 0;
        foreach (var line in lines)
        {
            var parts = line.Split(';', 2);
            var name = parts[0].Trim();
            if (string.IsNullOrWhiteSpace(name)) continue;

            var price = parts.Length > 1 ? ParsePrice(parts[1]) : 0;

            db.ExtraOptions.Add(new ExtraOption
            {
                Name = name,
                Price = price,
                MenuCategoryId = bulkAddCategoryId == 0 ? null : bulkAddCategoryId
            });
            count++;
        }
        await db.SaveChangesAsync();

        bulkAddMessage = $"Προστέθηκαν {count} extra.";
        bulkAddText = "";
        await Load();
    }

    private void StartEdit(ExtraOption e)
    {
        editingId = e.Id;
        editName = e.Name;
        editPrice = e.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        editCategoryId = e.MenuCategoryId ?? 0;
    }

    private void CancelEdit()
    {
        editingId = null;
    }

    private async Task SaveEdit(ExtraOption e)
    {
        if (string.IsNullOrWhiteSpace(editName)) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.ExtraOptions.FindAsync(e.Id);
        if (entity is not null)
        {
            entity.Name = editName.Trim();
            entity.Price = ParsePrice(editPrice);
            entity.MenuCategoryId = editCategoryId == 0 ? null : editCategoryId;
            await db.SaveChangesAsync();
        }

        editingId = null;
        await Load();
    }

    private void ToggleSelect(int id, ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false)) selectedIds.Add(id);
        else selectedIds.Remove(id);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false)) selectedIds = items.Select(i => i.Id).ToHashSet();
        else selectedIds.Clear();
    }

    private async Task ApplyBulkCategory()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var toUpdate = await db.ExtraOptions.Where(e => selectedIds.Contains(e.Id)).ToListAsync();
        foreach (var e in toUpdate)
        {
            e.MenuCategoryId = bulkCategoryId == 0 ? null : bulkCategoryId;
        }
        await db.SaveChangesAsync();
        await Load();
    }

    private async Task DeleteSelected()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var toDelete = await db.ExtraOptions.Where(e => selectedIds.Contains(e.Id)).ToListAsync();
        db.ExtraOptions.RemoveRange(toDelete);
        await db.SaveChangesAsync();
        selectedIds.Clear();
        await Load();
    }

    private async Task Delete(ExtraOption e)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.ExtraOptions.FindAsync(e.Id);
        if (entity is not null)
        {
            db.ExtraOptions.Remove(entity);
            await db.SaveChangesAsync();
        }
        await Load();
    }

    private async Task HandleExcelUpload(InputFileChangeEventArgs e)
    {
        excelImportMessage = null;
        isImportingExcel = true;
        StateHasChanged();

        try
        {
            var file = e.File;
            if (file is null) return;

            using var stream = file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            List<Dictionary<string, string>> rows;
            try
            {
                rows = ExcelImportService.ReadRows(ms);
            }
            catch (Exception ex)
            {
                excelImportMessage = $"Σφάλμα ανάγνωσης αρχείου: {ex.Message}";
                return;
            }

            using var db = await DbFactory.CreateDbContextAsync();
            var existingCategories = await db.MenuCategories.ToListAsync();
            var count = 0;

            foreach (var row in rows)
            {
                var name = ExcelImportService.GetField(row, "Extra", "Όνομα", "Ονομα", "Name");
                if (string.IsNullOrWhiteSpace(name)) continue;

                var categoryName = ExcelImportService.GetField(row, "Κατηγορία", "Κατηγορια", "Category");
                var priceRaw = ExcelImportService.GetField(row, "Τιμή", "Τιμη", "Price");
                var price = ParsePrice(priceRaw);

                int? categoryId = null;
                if (!string.IsNullOrWhiteSpace(categoryName))
                {
                    var cat = existingCategories.FirstOrDefault(c =>
                        string.Equals(c.Name, categoryName.Trim(), StringComparison.OrdinalIgnoreCase));
                    if (cat is null)
                    {
                        cat = new MenuCategory { Name = categoryName.Trim() };
                        db.MenuCategories.Add(cat);
                        await db.SaveChangesAsync();
                        existingCategories.Add(cat);
                    }
                    categoryId = cat.Id;
                }

                db.ExtraOptions.Add(new ExtraOption
                {
                    Name = name.Trim(),
                    Price = price,
                    MenuCategoryId = categoryId
                });
                count++;
            }

            await db.SaveChangesAsync();
            excelImportMessage = $"Εισήχθησαν {count} extra από το αρχείο.";
            await Load();
        }
        catch (Exception ex)
        {
            excelImportMessage = $"Απέτυχε η εισαγωγή: {ex.Message}";
        }
        finally
        {
            isImportingExcel = false;
        }
    }
}
