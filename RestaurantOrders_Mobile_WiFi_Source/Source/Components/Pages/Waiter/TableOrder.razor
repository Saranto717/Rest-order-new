    private int RemainingQuantityForItem(OrderItem item)
    {
        var paid = paidQuantitiesByItem.TryGetValue(item.Id, out var q) ? q : 0;
        return Math.Max(0, item.Quantity - paid);
    }

    private decimal CurrentOrderTotal => order.Items.Where(i => !i.IsCancelled)
        .Sum(i => RemainingQuantityForItem(i) * ((i.MenuItem?.Price ?? 0) + i.ExtrasPrice));

    private decimal SplitSelectedTotal => splitPaymentItems.Sum(i =>
    {
        var q = splitQuantities.TryGetValue(i.Id, out var selected) ? selected : 0;
        return q * ((i.MenuItem?.Price ?? 0) + i.ExtrasPrice);
    });



    private async Task BeginSplitPayment()

    {

        fiscalError = null;

        using var db = await DbFactory.CreateDbContextAsync();

        var activeSplitItems = await db.OrderItems.Include(i => i.MenuItem).ThenInclude(m => m!.MenuCategory)
            .Where(i => i.OrderId == order.Id && !i.IsCancelled && i.Quantity > 0).OrderBy(i => i.Id).ToListAsync();
        var paid = await db.OrderPaymentItems
            .Where(pi => pi.OrderPayment != null && pi.OrderPayment.OrderId == order.Id && pi.OrderPayment.FiscalStatus == FiscalStatus.Issued)
            .GroupBy(pi => pi.OrderItemId).Select(g => new { OrderItemId = g.Key, Quantity = g.Sum(x => x.Quantity) })
            .ToDictionaryAsync(x => x.OrderItemId, x => x.Quantity);
        splitPaymentItems = activeSplitItems.Select(i =>
        {
            var alreadyPaid = paid.TryGetValue(i.Id, out var q) ? q : 0;
            var remaining = i.Quantity - alreadyPaid;
            if (remaining <= 0) return null;
            return new OrderItem { Id = i.Id, OrderId = i.OrderId, MenuItemId = i.MenuItemId, MenuItem = i.MenuItem, Quantity = remaining, ExtrasPrice = i.ExtrasPrice, Notes = i.Notes, IsCancelled = false };
        }).Where(i => i is not null).Select(i => i!).ToList();
        splitQuantities = splitPaymentItems.ToDictionary(i => i.Id, _ => 0);

        if (splitPaymentItems.Count == 0)

        {

            fiscalError = "Δεν υπάρχουν ενεργά είδη για split πληρωμή.";

            return;

        }

        isSplitPaymentFlow = true;

        closeStep = 7;

    }



    private void SetSplitQuantity(int itemId, string? value)

    {

        if (!int.TryParse(value, out var q)) q = 0;

        var item = splitPaymentItems.FirstOrDefault(i => i.Id == itemId);

        splitQuantities[itemId] = Math.Clamp(q, 0, item?.Quantity ?? 0);

    }



    private void ContinueSplitPayment()

    {

        fiscalError = null;

        if (SplitSelectedTotal <= 0)

        {

            fiscalError = "Επίλεξε τουλάχιστον ένα τεμάχιο.";

            return;

        }

        closeStep = 8;

    }



    private async Task SelectSplitPayment(PaymentMethod method)

    {

        selectedPaymentMethod = method;

        cardFiscalRetryOnly = false;
        cardFiscalRetryRequiresRecovery = false;
        if (method == PaymentMethod.Card)
        {
            await LoadCardPosSettingsAsync();
            using var db = await DbFactory.CreateDbContextAsync();
            var savedOrder = await db.Orders.FirstOrDefaultAsync(x => x.Id == order.Id);
            if (savedOrder is not null && savedOrder.Status == OrderStatus.Open &&
                savedOrder.PaymentMethod == PaymentMethod.Card &&
                !string.IsNullOrWhiteSpace(savedOrder.CardTransactionId))
            {
                cardFiscalRetryOnly = true;
                cardTransactionId = savedOrder.CardTransactionId.Trim();
                pendingCardTerminalId = savedOrder.CardTerminalId ?? string.Empty;
                pendingCardDocumentKind = savedOrder.DocumentKind is FiscalDocumentKind.Receipt or FiscalDocumentKind.Invoice
                    ? savedOrder.DocumentKind.Value
                    : FiscalDocumentKind.Receipt;

                var isEdpsWebEcr = cardPosSettings.Any(x => x.Provider == "EDPS" &&
                    x.Protocol.Contains("WebECR API v6") &&
                    string.Equals(x.TerminalId?.Trim(), savedOrder.CardTerminalId?.Trim(), StringComparison.OrdinalIgnoreCase));
                var expectedPaymentExternalSystemIdPrefix = $"payment-{savedOrder.Id}-";
                cardFiscalRetryRequiresRecovery = isEdpsWebEcr && savedOrder.ParochosMark is null &&
                    !string.IsNullOrWhiteSpace(savedOrder.ParochosPaymentUid) &&
                    !(savedOrder.ParochosExternalId?.StartsWith(expectedPaymentExternalSystemIdPrefix, StringComparison.OrdinalIgnoreCase) ?? false);

                fiscalError = cardFiscalRetryRequiresRecovery
                    ? "Η παλιά προσπάθεια χρέωσε την κάρτα αλλά συνέδεσε την υπογραφή με διαφορετικό αναγνωριστικό παραστατικού. Δεν γίνεται ασφαλής επανέκδοση από εδώ. Μην ξαναστείλεις ποσό στο POS· χρειάζεται ανάκτηση από τα στοιχεία Parochos."
                    : "Υπάρχει ήδη εγκεκριμένη συναλλαγή. Θα επαναληφθεί μόνο η έκδοση του ίδιου παραστατικού, χωρίς νέα χρέωση.";
                closeStep = 2;
                return;
            }
        }

        closeStep = 9;

    }



    private List<OrderItem> BuildSelectedSplitItems() => splitPaymentItems

        .Where(i => splitQuantities.TryGetValue(i.Id, out var q) && q > 0)

        .Select(i => new OrderItem

        {

            Id = i.Id,

            OrderId = i.OrderId,

            MenuItemId = i.MenuItemId,

            MenuItem = i.MenuItem,

            Quantity = splitQuantities[i.Id],

            ExtrasPrice = i.ExtrasPrice,

            Notes = i.Notes,

            IsCancelled = false

        }).ToList();



    private async Task IssueSelectedPayment(FiscalDocumentKind kind)

    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;


        fiscalError = null;

        splitDocumentKind = kind;

        var selected = BuildSelectedSplitItems();

        if (selected.Count == 0) { fiscalError = "Δεν επιλέχθηκαν είδη."; return; }



        if (cardFiscalRetryOnly)
        {
            if (kind != pendingCardDocumentKind)
            {
                fiscalError = "Η ήδη εγκεκριμένη πληρωμή είναι συνδεδεμένη με συγκεκριμένο τύπο παραστατικού. Δεν ξεκίνησε νέα χρέωση.";
                return;
            }
            await RetryApprovedCardFiscalDocument();
            return;
        }

        if (kind == FiscalDocumentKind.Invoice)

        {

            closeStep = 3;

            return;

        }



        if (selectedPaymentMethod == PaymentMethod.Card)

        {

            using var db = await DbFactory.CreateDbContextAsync();

            var o = await db.Orders.Include(x => x.RestaurantTable).FirstOrDefaultAsync(x => x.Id == order.Id);

            if (o is null) { fiscalError = "Η παραγγελία δεν βρέθηκε."; return; }

            if (SelectedCardPosSetting is null) { fiscalError = "Επίλεξε ενεργό συνδεδεμένο POS."; return; }
            var prep = await Fiscal.PrepareSelectedCardPaymentAsync(db, o, selected, kind, SelectedCardPosSetting);

            if (!prep.Success) { fiscalError = prep.ErrorMessage; return; }

            splitPendingCardPayment = prep;
            edpsRetryWithFreshProviderData = false;
            edpsStatusCheckRequired = false;

            pendingCardAmount = prep.Amount;

            pendingCardTerminalId = prep.TerminalId;

            pendingCardDocumentKind = kind;

            cardTransactionId = "";

            closeStep = 10;

            return;

        }



        await CompleteSplitPayment(null);

    }



    private async Task LoadCardPosSettingsAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        cardPosSettings = await db.BankPosTerminalSettings
            .Where(x => x.IsEnabled &&
                (x.Provider.Contains("ePay") || x.Provider.Contains("Euronet") || x.Protocol.Contains("Common WebECR") ||
                 (x.Provider == "EDPS" && x.Protocol.Contains("WebECR API v6")) ||
                 (x.Provider == "Viva" && x.Protocol == "Viva Cloud")))
            .OrderByDescending(x => x.UpdatedAt)
            .ThenBy(x => x.Name)
            .ToListAsync();
        cardPosSettings = cardPosSettings.Where(x =>
            CommonWebEcrProviderProfile.IsCommonRest(x)
                ? MellonConnectionSettings.IsConnected(x)
                : x.Provider.Contains("ePay", StringComparison.OrdinalIgnoreCase) ||
                  x.Provider.Contains("Euronet", StringComparison.OrdinalIgnoreCase) ||
                  (x.Provider == "EDPS" && x.Protocol.Contains("WebECR API v6")) ||
                  (x.Provider == "Viva" && x.Protocol == "Viva Cloud" &&
                   !string.IsNullOrWhiteSpace(x.TerminalId) && !string.IsNullOrWhiteSpace(x.ProviderCode) &&
                   !string.IsNullOrWhiteSpace(x.ApiKey) && !string.IsNullOrWhiteSpace(x.ApiSecret) &&
                   !string.IsNullOrWhiteSpace(x.ParochosNspCode))).ToList();
        selectedCardPosSettingsId = cardPosSettings.FirstOrDefault()?.Id ?? 0;
        CardPosChanged();
        if (cardPosSettings.Count == 0)
            fiscalError = "Δεν υπάρχει ενεργό συνδεδεμένο POS. Έλεγξε τις ρυθμίσεις στα Τραπεζικά POS.";
    }

    private async Task LoadEpayTerminals(bool isSplit)
    {
        if (epayBusy) return;
        epayBusy = true;
        fiscalError = null;
        epayTerminals.Clear();
        selectedEpayBackendId = "";
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var terminal = await db.BankPosTerminalSettings
                .FirstOrDefaultAsync(x => x.Id == selectedCardPosSettingsId && x.IsEnabled &&
                    (x.Provider.Contains("ePay") || x.Provider.Contains("Euronet") || x.Protocol.Contains("Common WebECR")));
            if (terminal is null && selectedCardPosSettingsId == 0)
                terminal = await db.BankPosTerminalSettings
                    .Where(x => x.IsEnabled && (x.Provider.Contains("ePay") || x.Provider.Contains("Euronet") || x.Protocol.Contains("Common WebECR")))
                    .OrderByDescending(x => x.UpdatedAt).FirstOrDefaultAsync();
            if (terminal is null) { fiscalError = "Δεν υπάρχει ενεργή σύνδεση WebECR (ePay / Mellon) στις Ρυθμίσεις → Τραπεζικά POS."; return; }
            selectedEpaySettingsId = terminal.Id;
            selectedEpayProviderCode = terminal.ProviderCode ?? "";
            var result = await Epay.GetTerminalsAsync(terminal);
            if (!result.Success) { fiscalError = result.Message; return; }
            epayTerminals = result.Terminals?.ToList() ?? new();
            if (epayTerminals.Count == 0) fiscalError = "Το ePay δεν επέστρεψε διαθέσιμα POS. Έλεγξε την εξουσιοδότηση WebECR.";
        }
        catch (Exception ex) { fiscalError = "Σφάλμα αναζήτησης POS: " + ex.Message; }
        finally { epayBusy = false; }
    }

