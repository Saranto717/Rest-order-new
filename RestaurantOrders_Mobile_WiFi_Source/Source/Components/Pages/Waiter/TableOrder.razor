    private async Task SendToKitchen()







    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;

        if (sendingToKitchen)
            return;

        sendingToKitchen = true;
        await InvokeAsync(StateHasChanged);

        try
        {








            using var db = await DbFactory.CreateDbContextAsync();















            var pending = await db.OrderItems







                .Include(oi => oi.MenuItem).ThenInclude(mi => mi!.MenuCategory).ThenInclude(c => c!.PrinterStations)







                .Where(oi => oi.OrderId == order.Id && !oi.IsPrinted && !oi.IsCancelled)







                .ToListAsync();















            if (!pending.Any())







            {







                statusMessage = "Δεν υπάρχουν νέα είδη για αποστολή.";







                return;







            }















            var waiterUser = await db.Users.FindAsync(currentUserId);







            var companySettings = await db.CompanySettings.FirstOrDefaultAsync();















            var fiscalOrder = await db.Orders.Include(o => o.RestaurantTable).FirstOrDefaultAsync(o => o.Id == order.Id);







            FiscalIssueResult orderFormResult;







            try







            {







                orderFormResult = fiscalOrder is not null







                    ? await Fiscal.IssueOrderFormAsync(db, fiscalOrder, pending)







                    : new FiscalIssueResult { Success = true };







            }







            catch (Exception ex)







            {







                orderFormResult = new FiscalIssueResult { Success = false, ErrorMessage = ex.Message };







            }















            // ============================================================







            // ΕΚΤΥΠΩΣΗ ΔΕΛΤΙΟΥ ΠΑΡΑΓΓΕΛΙΑΣ







            // ============================================================







            if (orderFormResult.Success)







            {







                try







                {







                    var orderFormStations = pending
                        .SelectMany(oi => GetCategoryPrinters(oi.MenuItem?.MenuCategory))
                        .DistinctBy(s => s.Id)
                        .ToList();















                    var orderFormItems = pending.Select(oi => (







                        ItemName: oi.MenuItem!.Name,







                        Quantity: oi.Quantity,







                        LineTotal: oi.Quantity * ((oi.MenuItem?.Price ?? 0) + oi.ExtrasPrice),







                        Notes: oi.Notes,







                        VatPercent: oi.MenuItem?.VatPercentOverride







                                    ?? oi.MenuItem?.MenuCategory?.VatPercent







                                    ?? 24m







                    )).ToList();















                    foreach (var station in orderFormStations)







                    {







                        var printed = await Printer.PrintOrderFormAsync(







                            station,







                            tableName,







                            waiterUser?.FullName ?? "-",







                            orderFormItems,







                            orderFormResult.Mark,







                            orderFormResult.QrCode,







                            companySettings);















                        if (!printed)







                        {







                            statusMessage +=







                                $" ⚠ Αποτυχία εκτύπωσης Δελτίου Παραγγελίας σε: {station.Name}.";







                        }







                    }







                }







                catch (Exception ex)







                {







                    statusMessage +=







                        $" ⚠ Σφάλμα εκτύπωσης Δελτίου Παραγγελίας: {ex.Message}";







                }







            }















            var withPrinter = pending.Where(oi => GetCategoryPrinters(oi.MenuItem?.MenuCategory).Count > 0).ToList();
            var withoutPrinter = pending.Where(oi => GetCategoryPrinters(oi.MenuItem?.MenuCategory).Count == 0).ToList();
            var groups = withPrinter
                .SelectMany(oi => GetCategoryPrinters(oi.MenuItem?.MenuCategory)
                    .Select(station => new { Station = station, Item = oi }))
                .GroupBy(x => x.Station)
                .ToList();
            var successStations = new List<string>();
            var failedStations = new List<string>();
            var itemsWithFailedPrinter = new HashSet<int>();
            foreach (var group in groups)
            {
                var station = group.Key;
                var ticketItems = group.Select(x => x.Item).Select(oi => (
                    Name: oi.MenuItem!.Name,
                    Quantity: oi.Quantity,
                    LineTotal: oi.Quantity * ((oi.MenuItem?.Price ?? 0) + oi.ExtrasPrice),
                    Notes: oi.Notes,
                    VatPercent: oi.MenuItem?.VatPercentOverride ?? oi.MenuItem?.MenuCategory?.VatPercent ?? 24m)).ToList();
                var ok = await Printer.PrintTicketAsync(station, tableName, waiterUser?.FullName ?? "-", ticketItems, companySettings);
                if (ok)
                {
                    successStations.Add(station.Name);
                }
                else
                {
                    failedStations.Add(station.Name);
                    foreach (var routedItem in group) itemsWithFailedPrinter.Add(routedItem.Item.Id);
                }
            }
            // Ένα είδος χαρακτηρίζεται ως απεσταλμένο μόνο όταν πέτυχαν όλοι οι εκτυπωτές του.
            if (orderFormResult.Success)
            {
                foreach (var oi in withPrinter.Where(oi => !itemsWithFailedPrinter.Contains(oi.Id)).Concat(withoutPrinter))
                {
                    oi.IsPrinted = true;
                    oi.PrintedAt = DateTime.Now;
                }
            }
            // Τα είδη χωρίς εκτυπωτή έχουν ενημερωθεί μαζί με τα υπόλοιπα μόνο αν πέτυχε το Δελτίο Παραγγελίας.















            await db.SaveChangesAsync();















            statusMessage = successStations.Any()







                ? $"Στάλθηκε σε: {string.Join(", ", successStations)}."







                : "Η παραγγελία καταχωρήθηκε.";







            if (failedStations.Any())







            {







                statusMessage += $" ⚠ Αποτυχία εκτύπωσης σε: {string.Join(", ", failedStations)} (η παραγγελία πάρθηκε κανονικά, απλά δεν τυπώθηκε εκεί).";







            }







            if (withoutPrinter.Any())







            {







                var missingCategories = withoutPrinter







                    .Select(oi => oi.MenuItem?.MenuCategory?.Name ?? "χωρίς κατηγορία")







                    .Distinct();







                statusMessage += $" ℹ Χωρίς εκτυπωτή (δεν τυπώθηκαν, καταχωρήθηκαν κανονικά): {string.Join(", ", missingCategories)}.";







            }







            if (!orderFormResult.Success)







            {







                statusMessage += $" ⚠ ΠΡΟΣΟΧΗ: απέτυχε η έκδοση φορολογικού Δελτίου Παραγγελίας στην ΑΑΔΕ: {orderFormResult.ErrorMessage}";







            }















            await JS.InvokeVoidAsync("playBeep");















            await LoadAsync();







        }
        finally
        {
            sendingToKitchen = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    private async Task ReprintOrder()
    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;

        using var db = await DbFactory.CreateDbContextAsync();

