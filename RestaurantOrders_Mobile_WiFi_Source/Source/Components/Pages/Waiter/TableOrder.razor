    private double? orderItemPointerStartX;
    private double? orderItemPointerStartY;
    private int? orderItemPointerItemId;
    private bool suppressNextOrderItemTap;

    private void OrderItemPointerDown(OrderItem item, PointerEventArgs e)
    {
        orderItemPointerStartX = e.ClientX;
        orderItemPointerStartY = e.ClientY;
        orderItemPointerItemId = item.Id;
        suppressNextOrderItemTap = false;
    }

    private async Task OrderItemPointerUp(OrderItem item, PointerEventArgs e)
    {
        if (orderItemPointerItemId != item.Id || orderItemPointerStartX is null || orderItemPointerStartY is null)
            return;

        var deltaX = e.ClientX - orderItemPointerStartX.Value;
        var deltaY = e.ClientY - orderItemPointerStartY.Value;
        orderItemPointerStartX = null;
        orderItemPointerStartY = null;
        orderItemPointerItemId = null;

        // Swipe left only; ignore vertical scrolling and short movements.
        if (deltaX <= -55 && Math.Abs(deltaX) > Math.Abs(deltaY) * 1.25)
        {
            suppressNextOrderItemTap = true;
            await DecreasePendingOrderItemByOne(item);
        }
    }

    private async Task HandleOrderItemTap(OrderItem item)
    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;

        if (suppressNextOrderItemTap)
        {
            suppressNextOrderItemTap = false;
            return;
        }

        // Items already sent to the kitchen/bar are immutable here; use the existing cancellation flow.
        if (item.IsPrinted || item.IsCancelled)
            return;

        using var db = await DbFactory.CreateDbContextAsync();
        var dbItem = await db.OrderItems.FirstOrDefaultAsync(i => i.Id == item.Id);
        if (dbItem is null || dbItem.IsPrinted || dbItem.IsCancelled)
            return;

        dbItem.Quantity += 1;
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task DecreasePendingOrderItemByOne(OrderItem item)
    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;

        if (item.IsPrinted || item.IsCancelled)
            return;

        using var db = await DbFactory.CreateDbContextAsync();
        var dbItem = await db.OrderItems.FirstOrDefaultAsync(i => i.Id == item.Id);
        if (dbItem is null || dbItem.IsPrinted || dbItem.IsCancelled)
            return;

        if (dbItem.Quantity <= 1)
            db.OrderItems.Remove(dbItem);
        else
            dbItem.Quantity -= 1;

        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task RemoveItemFromPendingOrder(OrderItem oi)
    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;

        // Όσο το είδος δεν έχει σταλεί, το Χ το αφαιρεί άμεσα από τα προς αποστολή.
        // Αν έχει ήδη σταλεί, κρατάμε την υπάρχουσα διαδικασία φορολογικής ακύρωσης.
        if (oi.IsPrinted)
        {
            BeginCancelItem(oi);
            return;
        }

        using var db = await DbFactory.CreateDbContextAsync();

        var dbItem = await db.OrderItems.FirstOrDefaultAsync(i => i.Id == oi.Id);
        if (dbItem is null)
            return;

        db.OrderItems.Remove(dbItem);
        await db.SaveChangesAsync();
        await LoadAsync();
    }



