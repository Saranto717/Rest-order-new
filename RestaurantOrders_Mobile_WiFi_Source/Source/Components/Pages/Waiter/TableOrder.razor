    private async Task StartSelectedVivaPayment(bool isSplit)
    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;

        if (epayBusy) return;
        if (!string.IsNullOrWhiteSpace(cardTransactionId))
        {
            // A successful card payment followed by a fiscal failure is a fiscal retry only.
            epayBusy = true;
            try { if (isSplit) await CompleteSplitCardPayment(); else await CompleteCardPayment(); }
            finally { epayBusy = false; }
            return;
        }
        var retryAfterManualStatusCheck = vivaStatusCheckRequired;
        if (retryAfterManualStatusCheck)
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                "Η προηγούμενη προσπάθεια Viva δεν επιβεβαιώθηκε. Έλεγξε πρώτα το ιστορικό συναλλαγών της Viva και το POS. Αν υπάρχει χρέωση, πάτησε Άκυρο. Μόνο αν επιβεβαίωσες ότι δεν χρεώθηκε, πάτησε OK για νέα προσπάθεια με νέα υπογραφή Parochos.");
            if (!confirmed) return;
            vivaStatusCheckRequired = false;
        }
        epayBusy = true;
        fiscalError = null;
        var requestMayHaveStarted = false;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var terminal = await db.BankPosTerminalSettings.FirstOrDefaultAsync(x =>
                x.Id == selectedCardPosSettingsId && x.IsEnabled && x.Provider == "Viva" && x.Protocol == "Viva Cloud");
            if (terminal is null) { fiscalError = "Η σύνδεση Viva δεν είναι πλέον ενεργή. Επίλεξε ξανά το POS."; return; }

            var preparation = isSplit ? splitPendingCardPayment : pendingCardPayment;
            if (retryAfterManualStatusCheck || preparation is null || !preparation.Success || preparation.ProviderData is null)
            {
                if (isSplit)
                {
                    var currentOrder = await db.Orders.Include(x => x.RestaurantTable).FirstOrDefaultAsync(x => x.Id == order.Id);
                    if (currentOrder is null) { fiscalError = "Η παραγγελία δεν βρέθηκε."; return; }
                    preparation = await Fiscal.PrepareSelectedCardPaymentAsync(db, currentOrder, BuildSelectedSplitItems(), pendingCardDocumentKind, terminal);
                    splitPendingCardPayment = preparation;
                }
                else
                {
                    var currentOrder = await db.Orders.Include(x => x.Items).ThenInclude(i => i.MenuItem).ThenInclude(m => m!.MenuCategory)
                        .FirstOrDefaultAsync(x => x.Id == order.Id);
                    if (currentOrder is null) { fiscalError = "Η παραγγελία δεν βρέθηκε."; return; }
                    preparation = await Fiscal.PrepareCardPaymentAsync(db, currentOrder, pendingCardDocumentKind, terminal);
                    pendingCardPayment = preparation;
                }
            }
            if (preparation is null || !preparation.Success || preparation.ProviderData is null)
            { fiscalError = preparation?.ErrorMessage ?? "Δεν δημιουργήθηκε έγκυρη υπογραφή Parochos. Δεν ξεκίνησε χρέωση."; return; }
            if (!string.Equals(preparation.TerminalId.Trim(), terminal.TerminalId.Trim(), StringComparison.OrdinalIgnoreCase))
            { fiscalError = "Το Terminal ID της υπογραφής Parochos δεν ταιριάζει με το επιλεγμένο Viva POS. Δεν ξεκίνησε χρέωση."; return; }
            var expectedCents = decimal.ToInt64(decimal.Round(pendingCardAmount * 100m, 0, MidpointRounding.AwayFromZero));
            var signedCents = decimal.ToInt64(decimal.Round(preparation.Amount * 100m, 0, MidpointRounding.AwayFromZero));
            if (expectedCents != signedCents)
            { pendingCardAmount = preparation.Amount; fiscalError = "Το ποσό της υπογραφής Parochos διαφέρει από το ποσό πληρωμής. Ελέγξτε το νέο ποσό και ξεκινήστε ξανά."; return; }

            requestMayHaveStarted = true;
            var reference = $"RO-{order.Id}-{(isSplit ? "SPLIT-" : "")}{Guid.NewGuid():N}";
            var result = await Viva.ChargeAsync(terminal, preparation.Amount, reference, preparation.ProviderData);
            vivaPendingSessionId = result.SessionId;
            if (!result.Success)
            {
                fiscalError = result.Message;
                vivaStatusCheckRequired = result.RequiresStatusCheck;
                return;
            }

            cardTransactionId = result.TransactionId ?? "";
            pendingCardTerminalId = terminal.TerminalId.Trim();
            if (!isSplit)
            {
                var currentOrder = await db.Orders.FirstOrDefaultAsync(x => x.Id == order.Id);
                if (currentOrder is not null)
                {
                    currentOrder.CardTransactionId = result.TransactionId;
                    currentOrder.CardTerminalId = pendingCardTerminalId;
                    currentOrder.CardNspCode = preparation.NspCode;
                    currentOrder.ParochosExternalId = preparation.ExternalSystemId;
                    currentOrder.InvoiceSeriesName = preparation.SeriesName;
                    currentOrder.InvoiceNumber = preparation.InvoiceNumber;
                    currentOrder.DocumentKind = pendingCardDocumentKind;
                    currentOrder.ParochosPaymentSignature = preparation.Signature;
                    currentOrder.ParochosPaymentUid = preparation.Uid;
                    await db.SaveChangesAsync();
                }
            }
            vivaStatusCheckRequired = false;
            if (isSplit) await CompleteSplitCardPayment(); else await CompleteCardPayment();
        }
        catch (Exception ex)
        {
            if (requestMayHaveStarted)
            {
                vivaStatusCheckRequired = true;
                fiscalError = "Δεν επιβεβαιώθηκε το αποτέλεσμα από τη Viva. Έλεγξε το ιστορικό POS πριν από οποιαδήποτε νέα προσπάθεια. " + ex.Message;
            }
            else fiscalError = "Σφάλμα προετοιμασίας Viva. Δεν ξεκίνησε χρέωση. " + ex.Message;
        }
        finally { epayBusy = false; }
    }

    private async Task StartSelectedEdpsPayment(bool isSplit)
    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;

        if (epayBusy) return;
        if (edpsStatusCheckRequired)
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                "Η κατάσταση της προηγούμενης προσπάθειας δεν επιβεβαιώθηκε από το EDPS. Έλεγξε το ιστορικό του POS. Αν επιβεβαίωσες ότι απορρίφθηκε και δεν χρεώθηκε, πάτησε OK για να δημιουργηθεί νέα υπογραφή Parochos και να σταλεί αμέσως νέα προσπάθεια. Αν εγκρίθηκε, πάτησε Άκυρο.");
            if (!confirmed) return;
            edpsStatusCheckRequired = false;
            edpsRetryWithFreshProviderData = true;
        }
        epayBusy = true;
        fiscalError = null;
        var txnInitMayHaveStarted = false;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var terminal = await db.BankPosTerminalSettings.FirstOrDefaultAsync(
                x => x.Id == selectedCardPosSettingsId && x.IsEnabled && x.Provider == "EDPS" && x.Protocol.Contains("WebECR API v6"));
            if (terminal is null)
            {
                fiscalError = "Η σύνδεση EDPS δεν είναι πλέον ενεργή. Επίλεξε ξανά τερματικό κάρτας.";
                return;
            }

            var preparation = isSplit ? splitPendingCardPayment : pendingCardPayment;
            if (edpsRetryWithFreshProviderData)
            {
                if (isSplit)
                {
                    var currentOrder = await db.Orders.Include(x => x.RestaurantTable)
                        .FirstOrDefaultAsync(x => x.Id == order.Id);
                    if (currentOrder is null)
                    {
                        fiscalError = "Η παραγγελία δεν βρέθηκε. Δεν ξεκίνησε χρέωση.";
                        return;
                    }
                    var selected = BuildSelectedSplitItems();
                    preparation = await Fiscal.PrepareSelectedCardPaymentAsync(
                        db, currentOrder, selected, pendingCardDocumentKind, terminal);
                }
                else
                {
                    var currentOrder = await db.Orders
                        .Include(x => x.Items).ThenInclude(i => i.MenuItem).ThenInclude(m => m!.MenuCategory)
                        .FirstOrDefaultAsync(x => x.Id == order.Id);
                    if (currentOrder is null)
                    {
                        fiscalError = "Η παραγγελία δεν βρέθηκε. Δεν ξεκίνησε χρέωση.";
                        return;
                    }
                    preparation = await Fiscal.PrepareCardPaymentAsync(
                        db, currentOrder, pendingCardDocumentKind, terminal);
                }

                if (!preparation.Success || preparation.ProviderData is null)
                {
                    fiscalError = preparation.ErrorMessage ?? "Ο Parochos δεν επέστρεψε νέα υπογραφή. Δεν ξεκίνησε χρέωση.";
                    return;
                }
                var previousAmountCents = decimal.ToInt32(decimal.Round(pendingCardAmount * 100m, 0, MidpointRounding.AwayFromZero));
                var newAmountCents = decimal.ToInt32(decimal.Round(preparation.Amount * 100m, 0, MidpointRounding.AwayFromZero));
                if (!string.Equals(preparation.TerminalId.Trim(), terminal.TerminalId.Trim(), StringComparison.OrdinalIgnoreCase))
                {
                    fiscalError = "Το TID της νέας υπογραφής Parochos δεν ταιριάζει με το επιλεγμένο EDPS POS. Δεν ξεκίνησε χρέωση.";
                    return;
                }

                if (isSplit)
                    splitPendingCardPayment = preparation;
                else
                    pendingCardPayment = preparation;
                pendingCardTerminalId = preparation.TerminalId;
                if (previousAmountCents != newAmountCents)
                {
                    pendingCardAmount = preparation.Amount;
                    edpsRetryWithFreshProviderData = false;
                    fiscalError = "Το ποσό άλλαξε. Εμφανίζεται το νέο σύνολο με νέα υπογραφή Parochos· έλεγξέ το και πάτησε ξανά αποστολή. Δεν ξεκίνησε χρέωση.";
                    return;
                }

                edpsRetryWithFreshProviderData = false;
            }

            var providerData = preparation?.ProviderData;
            if (preparation is null || !preparation.Success || providerData is null)
            {
                fiscalError = "Δεν υπάρχουν έγκυρα ProviderData Parochos για το EDPS. Δεν ξεκίνησε χρέωση.";
                return;
            }
            if (!string.Equals(preparation.TerminalId.Trim(), terminal.TerminalId.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                fiscalError = $"Το TID της υπογραφής Parochos ({preparation.TerminalId}) δεν ταιριάζει με το επιλεγμένο EDPS POS ({terminal.TerminalId}). Δεν ξεκίνησε χρέωση.";
                return;
            }

            var reference = isSplit
                ? $"RO-SPLIT-{order.Id}-{Guid.NewGuid():N}"
                : $"RO-{order.Id}-{Guid.NewGuid():N}";
            txnInitMayHaveStarted = true;
            var result = await Edps.ChargeAsync(terminal, preparation.Amount, reference, providerData);
            if (!result.Success)
            {
                fiscalError = result.Message;
                edpsRetryWithFreshProviderData = result.RetryRequiresFreshProviderData;
                edpsStatusCheckRequired = result.RequiresStatusCheck;
                return;
            }

            edpsRetryWithFreshProviderData = false;
            edpsStatusCheckRequired = false;
            cardTransactionId = result.TransactionId;
            pendingCardTerminalId = terminal.TerminalId.Trim();
            if (!isSplit)
            {
                var currentOrder = await db.Orders.FirstOrDefaultAsync(x => x.Id == order.Id);
                if (currentOrder is not null)
                {
                    currentOrder.CardTransactionId = result.TransactionId;
                    currentOrder.CardTerminalId = pendingCardTerminalId;
                    currentOrder.CardNspCode = preparation.NspCode;
                    currentOrder.ParochosExternalId = preparation.ExternalSystemId;
                    currentOrder.InvoiceSeriesName = preparation.SeriesName;
                    currentOrder.InvoiceNumber = preparation.InvoiceNumber;
                    currentOrder.DocumentKind = pendingCardDocumentKind;
                    currentOrder.ParochosPaymentSignature = preparation.Signature;
                    currentOrder.ParochosPaymentUid = preparation.Uid;
                    await db.SaveChangesAsync();
                }
            }

            if (isSplit) await CompleteSplitCardPayment(); else await CompleteCardPayment();
        }
        catch (Exception)
        {
            if (txnInitMayHaveStarted)
            {
                edpsStatusCheckRequired = true;
                fiscalError = "Δεν επιβεβαιώθηκε η απάντηση του EDPS. Έλεγξε το ιστορικό του POS πριν από νέα προσπάθεια.";
            }
            else
            {
                fiscalError = "Σφάλμα προετοιμασίας της συναλλαγής EDPS. Δεν ξεκίνησε χρέωση.";
            }
        }
        finally
        {
            epayBusy = false;
        }
    }

    private async Task CompleteSplitCardPayment()

    {

        if (string.IsNullOrWhiteSpace(cardTransactionId))

        {

            fiscalError = "Συμπλήρωσε το Transaction ID από το EFT-POS.";

            return;

        }

        await CompleteSplitPayment(cardTransactionId.Trim());

    }



    private async Task CompleteSplitPayment(string? transactionId)

    {

        closeStep = 4;

        fiscalError = null;

        try

        {

            using var db = await DbFactory.CreateDbContextAsync();

            var o = await db.Orders.Include(x => x.RestaurantTable).FirstOrDefaultAsync(x => x.Id == order.Id);

            if (o is null) { fiscalError = "Η παραγγελία δεν βρέθηκε."; closeStep = 7; return; }

            var selected = BuildSelectedSplitItems();

            var result = await Fiscal.IssueSelectedItemsPaymentAsync(

                db, o, selected, selectedPaymentMethod, splitDocumentKind, transactionId,

                splitPendingCardPayment?.Signature, pendingCardTerminalId,
                splitPendingCardPayment?.NspCode ?? (IsSelectedEdpsWebEcr ? "5" : "2"),
                splitPendingCardPayment?.ExternalSystemId,
                splitPendingCardPayment?.SeriesName,
                splitPendingCardPayment?.InvoiceNumber);

            if (!result.Success)

            {

                fiscalError = "Απέτυχε η έκδοση: " + result.ErrorMessage;

                closeStep = selectedPaymentMethod == PaymentMethod.Card ? 10 : 9;

                return;

            }



            var activeItems = await db.OrderItems.Where(i => i.OrderId == o.Id && !i.IsCancelled)
                .Select(i => new { i.Id, i.Quantity }).ToListAsync();
            var paidQuantities = await db.OrderPaymentItems
                .Where(pi => pi.OrderPayment != null && pi.OrderPayment.OrderId == o.Id && pi.OrderPayment.FiscalStatus == FiscalStatus.Issued)
                .GroupBy(pi => pi.OrderItemId).Select(g => new { OrderItemId = g.Key, Quantity = g.Sum(x => x.Quantity) })
                .ToDictionaryAsync(x => x.OrderItemId, x => x.Quantity);
            var hasRemaining = activeItems.Any(i => (paidQuantities.TryGetValue(i.Id, out var q) ? q : 0) < i.Quantity);
            if (!hasRemaining)
            {
                o.Status = OrderStatus.Closed;
                o.ClosedAt = DateTime.Now;
                await db.SaveChangesAsync();
            }
            else
            {
                await LoadAsync();
            }



            lastDocumentLabel = splitDocumentKind == FiscalDocumentKind.Invoice ? "Τιμολόγιο" : "Απόδειξη";

            lastSeriesAndNumber = "Split payment";

            lastMark = result.Mark;

            lastPdfUrl = null;

            closeStep = 5;

        }

        catch (Exception ex)

        {

            fiscalError = "Απρόσμενο σφάλμα: " + ex.Message;

            closeStep = 9;

        }

    }



