    private async Task ConfirmAddItem()







    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;








        if (pendingItem is null) return;















        var selectedExtras = allExtras.Where(e => pendingSelectedExtras.Contains(e.Id)).ToList();







