    private async Task LookupCustomerByVatAsync()







    {







        var vat = NormalizedCounterpartVat;







        if (vat.Length != 9)







            return;















        aadeLookupInProgress = true;







        aadeLookupError = null;







        aadeCustomerFound = false;















        try







        {







            using var db = await DbFactory.CreateDbContextAsync();







            var settings = await db.CompanySettings.FirstOrDefaultAsync();















            var result = await AadeRegistry.LookupAsync(vat);















            if (!result.Success || result.Customer is null)







            {







                aadeLookupError = result.ErrorMessage ?? "Δεν βρέθηκαν στοιχεία για το συγκεκριμένο ΑΦΜ.";







                return;







            }















            var customer = result.Customer;















            counterpartVat = customer.VatNumber;







            counterpartName = customer.Name;







            counterpartStreet = customer.Address;







            counterpartCity = customer.City;







            counterpartPostalCode = customer.PostalCode;







