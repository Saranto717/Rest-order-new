@if (showTableTransferModal)
{
    <div class="pin-overlay" style="z-index:10000" role="dialog" aria-modal="true" aria-labelledby="table-transfer-title">
        <div class="pin-box table-transfer-box">
            <h3 id="table-transfer-title">Μεταφορά παραγγελίας</h3>
            @if (pendingTableTransfer is not null)
            {
                <p>@pendingTableTransfer.SourceName → @pendingTableTransfer.TargetName</p>
                <p class="hint">Η μεταφορά εκκρεμεί. Τα δύο τραπέζια παραμένουν δεσμευμένα μέχρι να επιβεβαιωθεί το αποτέλεσμα.</p>
                <button disabled="@tableTransferBusy" @onclick="RecheckTableTransfer">@(tableTransferBusy ? "Έλεγχος…" : "Επανέλεγχος μεταφοράς")</button>
                <button class="linkbtn-plain" disabled="@tableTransferBusy" @onclick='() => Nav.NavigateTo("/waiter")'>Πίσω στα τραπέζια</button>
            }
            else
            {
                <p>Μεταφορά όλων των ειδών από <strong>@tableName</strong>.</p>
                <label for="transfer-table">Τραπέζι προορισμού</label>
                <select id="transfer-table" @bind="tableTransferTargetId" disabled="@tableTransferBusy">
                    <option value="0">Επίλεξε τραπέζι…</option>
                    @foreach (var target in tableTransferTargets)
                    {
                        <option value="@target.Id">@target.Name @(occupiedTransferTargets.Contains(target.Id) ? "— συγχώνευση με υπάρχουσα παραγγελία" : "— ελεύθερο")</option>
                    }
                </select>
                <p class="hint">Το αρχικό τραπέζι θα ελευθερωθεί. Σε κατειλημμένο προορισμό θα ενωθούν οι παραγγελίες. Διατηρούνται τα υπάρχοντα δελτία και δεν εκδίδεται απόδειξη ή νέα χρέωση.</p>
                <p class="hint">Η μεταφορά δεν υποστηρίζει παραγγελίες με ήδη καταχωρισμένη πληρωμή ή δεσμευμένη υπογραφή.</p>
                <button disabled="@(tableTransferBusy || tableTransferTargetId == 0)" @onclick="ConfirmTableTransfer">@(tableTransferBusy ? "Μεταφορά…" : "Μεταφορά όλων των ειδών")</button>
                <button class="linkbtn-plain" disabled="@tableTransferBusy" @onclick="() => showTableTransferModal = false">Άκυρο</button>
            }
            @if (!string.IsNullOrWhiteSpace(tableTransferMessage)) { <p class="error" role="alert">@tableTransferMessage</p> }
        </div>
    </div>
}

@code {
    private bool showTableTransferModal;
    private bool tableTransferBusy;
    private int tableTransferTargetId;
    private string? tableTransferMessage;
    private TableTransfer? pendingTableTransfer;
    private List<RestaurantTable> tableTransferTargets = new();
    private HashSet<int> occupiedTransferTargets = new();

    private async Task<bool> EnsureCurrentTableAvailable()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        pendingTableTransfer = await db.TableTransfers.AsNoTracking().FirstOrDefaultAsync(t =>
            t.Stage != TableTransferStage.Completed && t.Stage != TableTransferStage.Rejected &&
            (t.SourceTableId == TableId || t.TargetTableId == TableId));
        if (pendingTableTransfer is not null)
        {
            tableTransferMessage = pendingTableTransfer.LastError;
            showTableTransferModal = true;
            return false;
        }
        if (!await db.Orders.AnyAsync(o => o.Id == order.Id && o.RestaurantTableId == TableId && o.Status == OrderStatus.Open))
        {
            Nav.NavigateTo("/waiter");
            return false;
        }
        return true;
    }

    private async Task BeginTableTransfer()
    {
        if (!await EnsureCurrentTableAvailable()) return;
        using var db = await DbFactory.CreateDbContextAsync();
        var locked = await db.TableTransfers.Where(t => t.Stage != TableTransferStage.Completed && t.Stage != TableTransferStage.Rejected)
            .Select(t => new { t.SourceTableId, t.TargetTableId }).ToListAsync();
        var lockedIds = locked.SelectMany(t => new[] { t.SourceTableId, t.TargetTableId }).ToHashSet();
        tableTransferTargets = (await db.Tables.Where(t => t.IsActive && t.Id != TableId).OrderBy(t => t.SortOrder).ThenBy(t => t.Name).ToListAsync())
            .Where(t => !lockedIds.Contains(t.Id)).ToList();
        occupiedTransferTargets = (await db.Orders.Where(o => o.Status == OrderStatus.Open && (o.Items.Any(i => !i.IsCancelled && i.Quantity > 0) ||
                db.FiscalOrderDocuments.Any(f => f.OrderId == o.Id && f.Mark != null && !f.IsCancelled)))
            .Select(o => o.RestaurantTableId).ToListAsync()).ToHashSet();
        tableTransferTargetId = 0; tableTransferMessage = null; showTableTransferModal = true;
    }

    private async Task ConfirmTableTransfer()
    {
        if (tableTransferBusy || tableTransferTargetId <= 0) return;
        tableTransferBusy = true;
        try { await HandleTransferResult(await Transfers.MoveAllAsync(order.Id, tableTransferTargetId, currentUserId)); }
        catch (Exception) { tableTransferMessage = "Η μεταφορά δεν επιβεβαιώθηκε λόγω σφάλματος σύνδεσης ή αποθήκευσης. Ανανέωσε τη σελίδα και έλεγξε τυχόν εκκρεμή μεταφορά πριν συνεχίσεις."; }
        finally { tableTransferBusy = false; }
    }

    private async Task RecheckTableTransfer()
    {
        if (tableTransferBusy || pendingTableTransfer is null) return;
        tableTransferBusy = true;
        try { await HandleTransferResult(await Transfers.RecheckAsync(pendingTableTransfer.Id)); }
        catch (Exception) { tableTransferMessage = "Δεν ολοκληρώθηκε ο επανέλεγχος. Η εκκρεμής μεταφορά διατηρείται· δοκίμασε τον επανέλεγχο ξανά όταν αποκατασταθεί η σύνδεση."; }
        finally { tableTransferBusy = false; }
    }

    private async Task HandleTransferResult(TableTransferResult result)
    {
        tableTransferMessage = result.Message;
        if (result.Success) { Nav.NavigateTo($"/waiter/table/{result.TargetTableId}", forceLoad: true); return; }
        if (result.Pending && result.TransferId is not null)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            pendingTableTransfer = await db.TableTransfers.AsNoTracking().FirstOrDefaultAsync(t => t.Id == result.TransferId);
        }
        else if (pendingTableTransfer is not null)
        {
            var wasSource = pendingTableTransfer.SourceTableId == TableId;
            pendingTableTransfer = null;
            if (!wasSource) { Nav.NavigateTo("/waiter"); return; }
            await BeginTableTransfer(); tableTransferMessage = result.Message;
        }
    }

    private static List<PrinterStation> GetCategoryPrinters(MenuCategory? category)
    {
        if (category is null) return new List<PrinterStation>();

        var stations = category.PrinterStations?.ToList() ?? new List<PrinterStation>();
        if (category.PrinterStation is not null && stations.All(s => s.Id != category.PrinterStation.Id))
            stations.Add(category.PrinterStation);

        return stations.DistinctBy(s => s.Id).ToList();
    }

    private const string DefaultBackground = "#f4f6f9";
    private const string TablesBackgroundKey = "restaurant.tables.background";
    private const string OrderBackgroundKey = "restaurant.tableorder.background";

    private string pageBackground = DefaultBackground;
    private string editingPageBackground = DefaultBackground;
    private bool showOrderBackgroundMenu;
    private double orderBackgroundMenuX = 20;
    private double orderBackgroundMenuY = 20;

    private const string CategoryStylesKey = "restaurant.tableorder.category.styles";
    private readonly Dictionary<int, CategoryStyle> categoryStyles = new();
    private CategoryStyle editingCategoryStyle = new();
    private int editingCategoryId;
    private bool showCategoryCustomizationMenu;
    private double categoryCustomizationX = 20;
    private double categoryCustomizationY = 20;

    private const string ActionButtonStylesKey = "restaurant.tableorder.actionbutton.styles";
    private readonly Dictionary<string, ActionButtonStyle> actionButtonStyles = new(StringComparer.OrdinalIgnoreCase);
    private ActionButtonStyle editingActionButtonStyle = new();
    private string editingActionButtonKey = "reprint";
    private bool showActionButtonCustomizationMenu;
    private double actionCustomizationX = 20;
    private double actionCustomizationY = 20;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // If this table page has no personal override, inherit the background
        // configured on the main table-selection page.
        var overrideBackground = await JS.InvokeAsync<string?>("localStorage.getItem", OrderBackgroundKey);
        var inheritedBackground = await JS.InvokeAsync<string?>("localStorage.getItem", TablesBackgroundKey);

        pageBackground = !string.IsNullOrWhiteSpace(overrideBackground)
            ? overrideBackground!
            : (!string.IsNullOrWhiteSpace(inheritedBackground) ? inheritedBackground! : DefaultBackground);

        editingPageBackground = pageBackground;

        var savedCategoryStyles = await JS.InvokeAsync<string?>("localStorage.getItem", CategoryStylesKey);
        if (!string.IsNullOrWhiteSpace(savedCategoryStyles))
        {
            try
            {
                var loaded = JsonSerializer.Deserialize<Dictionary<int, CategoryStyle>>(savedCategoryStyles);
                if (loaded is not null)
                {
                    categoryStyles.Clear();
                    foreach (var pair in loaded)
                        categoryStyles[pair.Key] = pair.Value;
                }
            }
            catch
            {
                categoryStyles.Clear();
            }
        }

        var savedActionButtonStyles = await JS.InvokeAsync<string?>("localStorage.getItem", ActionButtonStylesKey);
        if (!string.IsNullOrWhiteSpace(savedActionButtonStyles))
        {
            try
            {
                var loaded = JsonSerializer.Deserialize<Dictionary<string, ActionButtonStyle>>(savedActionButtonStyles);
                if (loaded is not null)
                {
                    actionButtonStyles.Clear();
                    foreach (var pair in loaded)
                        actionButtonStyles[pair.Key] = pair.Value;
                }
            }
            catch
            {
                actionButtonStyles.Clear();
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private string GetCategoryStyle(int categoryId)
    {
        if (!categoryStyles.TryGetValue(categoryId, out var style))
            return "";

        var active = selectedCategoryId == categoryId;
        var background = active ? style.Background : style.Background;
        return $"background:{background};color:{style.TextColor};border-color:{style.BorderColor};width:min({style.Width}px, 100%);min-height:{style.Height}px;height:{style.Height}px;font-size:{style.FontSize}px;font-weight:{(style.Bold ? 800 : 400)};";
    }

    private int GetCategoryPanelWidth()
    {
        var widestCategory = categoryStyles.Count == 0
            ? 100
            : categoryStyles.Values.Max(s => s.Width);

        // Keep enough room for the products and order columns. The actual CSS
        // also clamps this value on smaller screens.
        return Math.Max(190, widestCategory + 20);
    }

    private void OpenCategoryCustomization(int categoryId, MouseEventArgs e)
    {
        showOrderBackgroundMenu = false;
        showCategoryCustomizationMenu = true;
        editingCategoryId = categoryId;
        editingCategoryStyle = categoryStyles.TryGetValue(categoryId, out var saved)
            ? saved.Clone()
            : new CategoryStyle();

        categoryCustomizationX = Math.Min(e.ClientX, Math.Max(10, 320));
        categoryCustomizationY = Math.Min(e.ClientY, Math.Max(10, 650));
    }

    private async Task SaveCategoryCustomization()
    {
        categoryStyles[editingCategoryId] = editingCategoryStyle.Clone();
        showCategoryCustomizationMenu = false;
        var json = JsonSerializer.Serialize(categoryStyles);
        await JS.InvokeVoidAsync("localStorage.setItem", CategoryStylesKey, json);
    }

    private async Task ResetCategoryCustomization()
    {
        categoryStyles.Remove(editingCategoryId);
        showCategoryCustomizationMenu = false;
        var json = JsonSerializer.Serialize(categoryStyles);
        await JS.InvokeVoidAsync("localStorage.setItem", CategoryStylesKey, json);
    }

    private void CloseCustomizationMenus()
    {
        showCategoryCustomizationMenu = false;
        showOrderBackgroundMenu = false;
        showActionButtonCustomizationMenu = false;
    }

    private string GetActionButtonStyle(string key)
    {
        var style = actionButtonStyles.TryGetValue(key, out var saved)
            ? saved
            : GetDefaultActionButtonStyle(key);

        return $"background-color:{style.Background};color:{style.TextColor};border:1px solid {style.BorderColor};";
    }

    private static string GetActionButtonDisplayName(string key) => key switch
    {
        "reprint" => "Επανεκτύπωση παραγγελίας",
        "bill" => "Λογαριασμός",
        "cancel" => "Ακύρωση παραγγελίας",
        "close" => "Κλείσιμο τραπεζιού",
        _ => "Κουμπί ενέργειας"
    };

    private static ActionButtonStyle GetDefaultActionButtonStyle(string key) => key switch
    {
        "reprint" => new ActionButtonStyle { Background = "#e7edfa", TextColor = "#334b75", BorderColor = "#c7d5ee" },
        "bill" => new ActionButtonStyle { Background = "#e7f3f8", TextColor = "#315a6b", BorderColor = "#c6e1eb" },
        "cancel" => new ActionButtonStyle { Background = "#fdebea", TextColor = "#8e3c36", BorderColor = "#f2c5c1" },
        "close" => new ActionButtonStyle { Background = "#e1f3e9", TextColor = "#2c6954", BorderColor = "#bfe2d1" },
        _ => new ActionButtonStyle()
    };

    private void OpenActionButtonCustomization(string key, MouseEventArgs e)
    {
        showOrderBackgroundMenu = false;
        showCategoryCustomizationMenu = false;
        showActionButtonCustomizationMenu = true;
        editingActionButtonKey = key;
        editingActionButtonStyle = actionButtonStyles.TryGetValue(key, out var saved)
            ? saved.Clone()
            : GetDefaultActionButtonStyle(key);

        // The menu opens next to the control while remaining inside the visible page.
        actionCustomizationX = Math.Max(10, e.ClientX - 300);
        actionCustomizationY = Math.Max(10, Math.Min(e.ClientY, 390));
    }

    private async Task SaveActionButtonCustomization()
    {
        actionButtonStyles[editingActionButtonKey] = editingActionButtonStyle.Clone();
        showActionButtonCustomizationMenu = false;
        var json = JsonSerializer.Serialize(actionButtonStyles);
        await JS.InvokeVoidAsync("localStorage.setItem", ActionButtonStylesKey, json);
    }

    private async Task ResetActionButtonCustomization()
    {
        actionButtonStyles.Remove(editingActionButtonKey);
        showActionButtonCustomizationMenu = false;
        var json = JsonSerializer.Serialize(actionButtonStyles);
        await JS.InvokeVoidAsync("localStorage.setItem", ActionButtonStylesKey, json);
    }

    private sealed class ActionButtonStyle
    {
        public string Background { get; set; } = "#e7edfa";
        public string TextColor { get; set; } = "#334b75";
        public string BorderColor { get; set; } = "#c7d5ee";

        public ActionButtonStyle Clone() => new()
        {
            Background = Background,
            TextColor = TextColor,
            BorderColor = BorderColor
        };
    }

    private sealed class CategoryStyle
    {
        public string Background { get; set; } = "#ffffff";
        public string TextColor { get; set; } = "#202736";
        public string BorderColor { get; set; } = "#d7dce5";
        public int Width { get; set; } = 100;
        public int Height { get; set; } = 48;
        public int FontSize { get; set; } = 16;
        public bool Bold { get; set; } = true;

        public CategoryStyle Clone() => new()
        {
            Background = Background,
            TextColor = TextColor,
            BorderColor = BorderColor,
            Width = Width,
