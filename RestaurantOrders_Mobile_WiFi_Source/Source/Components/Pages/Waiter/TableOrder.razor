    private async Task SelectItem(MenuItem item)
    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;

        // Εάν το προϊόν έχει extra συνδεδεμένα με την κατηγορία του,
        // ζητάμε πρώτα επιλογή. Διαφορετικά προστίθεται άμεσα όπως πριν.
        var availableExtras = allExtras
            .Where(e => e.MenuCategoryId == null || e.MenuCategoryId == item.MenuCategoryId)
            .ToList();

        if (availableExtras.Count > 0)
        {
            pendingItem = item;
            pendingQty = 1;
            pendingSelectedExtras.Clear();
            showExtraPanel = true;
            statusMessage = null;
            return;
        }

        using var db = await DbFactory.CreateDbContextAsync();
        var existingLine = await db.OrderItems.FirstOrDefaultAsync(oi =>
            oi.OrderId == order.Id &&
            oi.MenuItemId == item.Id &&
            !oi.IsPrinted &&
            !oi.IsCancelled &&
            string.IsNullOrEmpty(oi.Notes));

        if (existingLine is not null)
        {
            existingLine.Quantity += 1;
        }
        else
        {
            db.OrderItems.Add(new OrderItem
            {
                OrderId = order.Id,
                MenuItemId = item.Id,
                Quantity = 1,
                Notes = null,
                ExtrasPrice = 0m
            });
        }

        await db.SaveChangesAsync();
        statusMessage = null;
        await LoadAsync();
    }

