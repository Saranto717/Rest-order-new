    private async Task StartSelectedEpayPayment(bool isSplit)
    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;

        var isMellon = IsSelectedMellonWebEcr;
        if (isMellon && !string.IsNullOrWhiteSpace(cardTransactionId))
        {
            if (isSplit) await CompleteSplitCardPayment(); else await CompleteCardPayment();
            return;
        }
        if (!isMellon && string.IsNullOrWhiteSpace(selectedEpayBackendId)) { fiscalError = "Επίλεξε πρώτα διαθέσιμο POS."; return; }
        epayBusy = true; fiscalError = null;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var settingsId = isMellon ? selectedCardPosSettingsId : selectedEpaySettingsId;
            var terminal = await db.BankPosTerminalSettings.FirstOrDefaultAsync(x => x.Id == settingsId && x.IsEnabled);
            if (terminal is null) { fiscalError = "Η σύνδεση ePay δεν είναι πλέον ενεργή. Κάνε ξανά αναζήτηση POS."; return; }
            if (isMellon && !MellonConnectionSettings.IsConnected(terminal))
            { fiscalError = "Το επιλεγμένο Mellon POS δεν είναι πλέον συνδεδεμένο. Έλεγξε τις ρυθμίσεις του."; return; }
            var reference = BuildEpayCustomerReference(order.Id);
            ProviderPaymentData? providerData;
            string? signedTerminalId;
            CardPaymentPreparation? cardPreparation = null;
            if (isSplit)
            {
                providerData = splitPendingCardPayment?.ProviderData;
                signedTerminalId = splitPendingCardPayment?.TerminalId;
            }
            else
            {
                // Full-payment signature must be generated for the full order amount immediately before txninit.
                var currentOrderForSignature = await db.Orders
                    .Include(x => x.Items).ThenInclude(i => i.MenuItem).ThenInclude(m => m!.MenuCategory)
                    .FirstOrDefaultAsync(x => x.Id == order.Id);
                if (currentOrderForSignature is null) { fiscalError = "Η παραγγελία δεν βρέθηκε για υπογραφή πληρωμής."; return; }
                var prep = await Fiscal.PrepareCardPaymentAsync(db, currentOrderForSignature, isMellon ? pendingCardDocumentKind : FiscalDocumentKind.Receipt, terminal);
                if (!prep.Success) { fiscalError = prep.ErrorMessage ?? "Αποτυχία προετοιμασίας υπογραφής παρόχου."; return; }
                cardPreparation = prep;
                providerData = prep.ProviderData;
                signedTerminalId = prep.TerminalId;
            }
            if (providerData is null) { fiscalError = "Δεν δημιουργήθηκαν ProviderData από τον πάροχο. Δεν ξεκίνησε χρέωση."; return; }
            if (isMellon && isSplit && (!string.Equals(splitPendingCardPayment?.NspCode, terminal.ParochosNspCode.Trim(), StringComparison.Ordinal) ||
                providerData.ProviderId != terminal.ProviderId))
            { fiscalError = "Άλλαξαν οι ρυθμίσεις υπογραφής του Mellon POS. Επίλεξε ξανά POS και παραστατικό πριν τη χρέωση."; return; }
            var selectedEpayTerminal = isMellon
                ? new EpayWebEcrService.TerminalChoice(terminal.IdUrl, terminal.TerminalId, terminal.MerchantId, terminal.ProviderCode)
                : epayTerminals.FirstOrDefault(x => x.BackendId == selectedEpayBackendId);
            if (selectedEpayTerminal is null) { fiscalError = "Selected WebECR POS was not found. No charge was started."; return; }
            if (!string.Equals(signedTerminalId?.Trim(), selectedEpayTerminal.TerminalId.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                fiscalError = $"Parochos signature TID ({signedTerminalId ?? "<missing>"}) does not match selected ePay POS TID ({selectedEpayTerminal.TerminalId}). No charge was started.";
                return;
            }
            var result = isMellon
                ? await ChargeMellonAsync(terminal, pendingCardAmount, reference, providerData)
                : await Epay.ChargeAsync(terminal, pendingCardAmount, reference, default, selectedEpayBackendId, providerData);
            if (!result.Success) { fiscalError = result.Message; return; }
            cardTransactionId = result.TransactionId;
            pendingCardTerminalId = selectedEpayTerminal.TerminalId;
            if (!isSplit)
            {
                var currentOrder = await db.Orders.FirstOrDefaultAsync(x => x.Id == order.Id);
                if (currentOrder is not null)
                {
                    currentOrder.CardTransactionId = result.TransactionId;
                    currentOrder.CardTerminalId = pendingCardTerminalId;
                    // Store the Parochos/AADE NSP code, not ePay WebECR ProviderId.
                    currentOrder.CardNspCode = cardPreparation?.NspCode ?? "2";
                    if (cardPreparation is not null)
                    {
                        currentOrder.ParochosExternalId = cardPreparation.ExternalSystemId;
                        currentOrder.InvoiceSeriesName = cardPreparation.SeriesName;
                        currentOrder.InvoiceNumber = cardPreparation.InvoiceNumber;
                        currentOrder.DocumentKind = isMellon ? pendingCardDocumentKind : FiscalDocumentKind.Receipt;
                        currentOrder.ParochosPaymentSignature = cardPreparation.Signature;
                        currentOrder.ParochosPaymentUid = cardPreparation.Uid;
                    }
                    await db.SaveChangesAsync();
                }
            }
            if (isSplit) await CompleteSplitCardPayment(); else await CompleteCardPayment();
        }
        finally { epayBusy = false; }
    }

    private async Task<EpayWebEcrService.PaymentResult> ChargeMellonAsync(
        BankPosTerminalSettings terminal, decimal amount, string reference, ProviderPaymentData providerData)
    {
        var result = await Mellon.ChargeAsync(terminal, amount, reference, providerData: providerData);
        return new(result.Success, result.TransactionId, result.Message, result.IntentId);
    }

    private static string BuildEpayCustomerReference(int orderId)
    {
        var athensTimeZone = TimeZoneInfo.FindSystemTimeZoneById(
            OperatingSystem.IsWindows() ? "GTB Standard Time" : "Europe/Athens");
        var localTimestamp = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, athensTimeZone)
            .ToString("yyyyMMddHHmmss", System.Globalization.CultureInfo.InvariantCulture);
        var orderReference = orderId.ToString("D10", System.Globalization.CultureInfo.InvariantCulture);
        var randomSuffix = System.Security.Cryptography.RandomNumberGenerator
            .GetInt32(0, 1_000_000_000)
            .ToString("D9", System.Globalization.CultureInfo.InvariantCulture);
        return orderReference + localTimestamp + randomSuffix;
    }

