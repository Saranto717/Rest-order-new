    private async Task ConfirmCancelItem()



    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;




        if (pendingCancellationItem is null || cancellationInProgress)



            return;







        cancellationInProgress = true;



        cancellationError = null;







        try



        {



            var itemId = pendingCancellationItem.Id;



            var wasPrinted = pendingCancellationItem.IsPrinted;



            var itemName = pendingCancellationItem.MenuItem?.Name ?? "Είδος";







            using var db = await DbFactory.CreateDbContextAsync();



            var dbOrder = await db.Orders



                .Include(o => o.RestaurantTable)



                .FirstOrDefaultAsync(o => o.Id == order.Id);







            if (dbOrder is null)



            {



                cancellationError = "Η παραγγελία δεν βρέθηκε.";



                return;



            }







            var result = wasPrinted



                ? await Fiscal.CancelSentOrderItemAsync(db, dbOrder, itemId)



                : await Fiscal.CancelSentOrderItemAsync(db, dbOrder, itemId);







            if (!result.Success)



            {



                cancellationError = result.ErrorMessage ?? "Απέτυχε η ακύρωση.";



                return;



            }







            var cancellationPrintFailed = false;
            if (wasPrinted && result.Mark is not null)
            {



                var cancelledDbItem = await db.OrderItems



                    .Include(i => i.MenuItem).ThenInclude(i => i!.MenuCategory).ThenInclude(c => c!.PrinterStations)



                    .FirstOrDefaultAsync(i => i.Id == itemId);



                var settings = await db.CompanySettings.FirstOrDefaultAsync();



                var waiter = await db.Users.FindAsync(currentUserId);



                var stations = GetCategoryPrinters(cancelledDbItem?.MenuItem?.MenuCategory);
                foreach (var station in stations)
                {
                    var printed = await Printer.PrintOrderFormAsync(
                        station,
                        tableName,
                        waiter?.FullName ?? "-",
                        new[] { (ItemName: itemName, Quantity: 1, LineTotal: 0m, Notes: "ΑΚΥΡΩΘΗΚΕ", VatPercent: 0m) },
                        result.Mark,
                        result.QrCode,
                        settings,
                        "ΑΚΥΡΩΤΙΚΟ ΔΕΛΤΙΟ ΠΑΡΑΓΓΕΛΙΑΣ");
                    if (!printed) cancellationPrintFailed = true;
                }



            }







            statusMessage = string.IsNullOrWhiteSpace(result.ErrorMessage)
                ? $"Ακυρώθηκε: {itemName}."
                : result.ErrorMessage;
            if (cancellationPrintFailed)
                statusMessage += " ⚠ Η ακύρωση καταχωρήθηκε, αλλά απέτυχε η εκτύπωση του ακυρωτικού σε έναν ή περισσότερους εκτυπωτές.";







            // Αν αυτό ήταν το τελευταίο ενεργό είδος, δεν πρέπει να μείνει



            // ανοιχτή η παραγγελία με σύνολο €0. Κλείνουμε το Point of Service



            // στον Parochos και την Order τοπικά.



            var hasActiveItems = await db.OrderItems



                .AnyAsync(i => i.OrderId == dbOrder.Id && !i.IsCancelled);







            if (!hasActiveItems)



            {



                var emptyClose = await Fiscal.CloseEmptyOrderAsync(db, dbOrder);







                if (!emptyClose.Success)



                {



                    cancellationError =



                        "Το είδος ακυρώθηκε, αλλά δεν μπόρεσε να κλείσει το τραπέζι: " +



                        emptyClose.ErrorMessage;



                    return;



                }







                dbOrder.Status = OrderStatus.Closed;



                dbOrder.ClosedAt = DateTime.Now;



                await db.SaveChangesAsync();







                statusMessage = "Ακυρώθηκε το τελευταίο είδος και το τραπέζι έκλεισε.";



                showCancelModal = false;



                pendingCancellationItem = null;



                await LoadAsync();



                return;



            }







            showCancelModal = false;



            pendingCancellationItem = null;



            await LoadAsync();



        }



        catch (Exception ex)



        {



            cancellationError = $"Σφάλμα ακύρωσης: {ex.Message}";



        }



        finally



        {



            cancellationInProgress = false;



        }



    }







