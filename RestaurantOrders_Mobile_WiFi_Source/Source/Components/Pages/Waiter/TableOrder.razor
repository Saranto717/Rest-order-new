    protected override async Task OnInitializedAsync()







    {







        var authState = await AuthProvider.GetAuthenticationStateAsync();







        currentUserId = int.Parse(authState.User.FindFirst(ClaimTypes.NameIdentifier)!.Value);















        await LoadAsync();







    }















    private async Task LoadAsync()







    {







        using var db = await DbFactory.CreateDbContextAsync();















        companySettings = await db.CompanySettings.FirstOrDefaultAsync();















        pendingTableTransfer = await db.TableTransfers.AsNoTracking().FirstOrDefaultAsync(t =>
            t.Stage != TableTransferStage.Completed && t.Stage != TableTransferStage.Rejected &&
            (t.SourceTableId == TableId || t.TargetTableId == TableId));
        if (pendingTableTransfer is not null)
        { showTableTransferModal = true; tableTransferMessage = pendingTableTransfer.LastError; }

        var table = await db.Tables.FindAsync(TableId);







        tableName = table?.Name ?? "Άγνωστο τραπέζι";















        categories = await db.MenuCategories
            .Where(c => c.IsActive)
            .Include(c => c.PrinterStation)
            .Include(c => c.PrinterStations)
            .OrderBy(c => c.Name)
            .ToListAsync();
        if (categories.Count == 0)
            selectedCategoryId = 0;
        else if (!categories.Any(c => c.Id == selectedCategoryId))
            selectedCategoryId = categories[0].Id;







        var allItems = await db.MenuItems.Where(i => i.IsAvailable).OrderBy(i => i.Name).ToListAsync();







        itemsByCategory = categories.ToDictionary(c => c.Id, c => allItems.Where(i => i.MenuCategoryId == c.Id).ToList());







        allExtras = await db.ExtraOptions.OrderBy(e => e.Name).ToListAsync();















        // Rebuild the paid quantities from successfully issued split payments on every reload.
        // The original OrderItem.Quantity remains the ordered quantity; the UI displays only unpaid quantity.
        paidQuantitiesByItem = new Dictionary<int, int>();
        var openOrderForPayments = await db.Orders
            .Where(o => o.RestaurantTableId == TableId && o.Status == OrderStatus.Open)
            .Select(o => o.Id)
            .FirstOrDefaultAsync();
        if (openOrderForPayments > 0)
        {
            paidQuantitiesByItem = await db.OrderPaymentItems
                .Where(pi => pi.OrderPayment != null
                    && pi.OrderPayment.OrderId == openOrderForPayments
                    && pi.OrderPayment.FiscalStatus == FiscalStatus.Issued)
                .GroupBy(pi => pi.OrderItemId)
                .Select(g => new { OrderItemId = g.Key, Quantity = g.Sum(x => x.Quantity) })
                .ToDictionaryAsync(x => x.OrderItemId, x => x.Quantity);
        }

        var existing = await db.Orders







            .Include(o => o.Items).ThenInclude(i => i.MenuItem)







            .FirstOrDefaultAsync(o => o.RestaurantTableId == TableId && o.Status == OrderStatus.Open);















        if (existing is null && pendingTableTransfer is not null)
        {
            order = new Order { RestaurantTableId = TableId, WaiterUserId = currentUserId };
            return;
        }
        if (existing is null)







        {







            existing = new Order { RestaurantTableId = TableId, WaiterUserId = currentUserId, Status = OrderStatus.Open };







            db.Orders.Add(existing);







            await db.SaveChangesAsync();







            existing = await db.Orders.Include(o => o.Items).ThenInclude(i => i.MenuItem)







                .FirstAsync(o => o.Id == existing.Id);







        }















        order = existing;







    }















