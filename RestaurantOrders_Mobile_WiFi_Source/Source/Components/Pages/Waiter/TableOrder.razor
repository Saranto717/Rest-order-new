    private async Task IssueAndClose(FiscalDocumentKind kind, bool cardPaymentReady = false)







    {







        closeStep = 4;







        fiscalError = null;







        StateHasChanged();















        try







        {







            using var db = await DbFactory.CreateDbContextAsync();







            var o = await db.Orders







    .Include(x => x.RestaurantTable)







    .Include(x => x.Items)







        .ThenInclude(i => i.MenuItem)







            .ThenInclude(mi => mi!.MenuCategory)







                .ThenInclude(c => c!.PrinterStations)







    .FirstOrDefaultAsync(x => x.Id == order.Id);















            if (o is null)







            {







                fiscalError = "Η παραγγελία δεν βρέθηκε.";







                closeStep = 2;







                return;







            }















            o.PaymentMethod = selectedPaymentMethod;















            if (kind == FiscalDocumentKind.Invoice)







            {







                o.CounterpartVatNumber = counterpartVat.Trim();







                o.CounterpartName = counterpartName.Trim();







                o.CounterpartStreet = counterpartStreet.Trim();







                o.CounterpartCity = counterpartCity.Trim();







                o.CounterpartPostalCode = counterpartPostalCode.Trim();







                o.CounterpartStreetNumber = "";







                o.CounterpartTaxOffice = counterpartDoy.Trim();







                o.CounterpartMainActivity = counterpartMainActivity.Trim();







            }















            // EFT-POS flow: requestPayment must happen before /api/send. The Parochos API







            // returns the provider signature; the actual POS transaction is performed by







            // the terminal/POS integration and returns a transaction id.







            if (o.PaymentMethod == PaymentMethod.Card && !cardPaymentReady &&
                !string.IsNullOrWhiteSpace(o.CardTransactionId))
            {
                if (kind != o.DocumentKind)
                {
                    fiscalError = "Υπάρχει ήδη εγκεκριμένη πληρωμή για διαφορετικό τύπο παραστατικού. Δεν ξεκίνησε νέα χρέωση.";
                    closeStep = 2;
                    return;
                }

                cardTransactionId = o.CardTransactionId.Trim();
                cardPaymentReady = true;
            }

            if (cardPaymentReady && o.PaymentMethod == PaymentMethod.Card &&
                !string.IsNullOrWhiteSpace(o.ParochosPaymentUid))
            {
                var isEdpsWebEcrPayment = await db.BankPosTerminalSettings.AnyAsync(x =>
                    x.Provider == "EDPS" && x.Protocol.Contains("WebECR API v6") &&
                    x.TerminalId == o.CardTerminalId);
                var expectedPaymentExternalSystemIdPrefix = $"payment-{o.Id}-";
                if (isEdpsWebEcrPayment && o.ParochosMark is null &&
                    !(o.ParochosExternalId?.StartsWith(expectedPaymentExternalSystemIdPrefix, StringComparison.OrdinalIgnoreCase) ?? false))
                {
                    cardFiscalRetryOnly = true;
                    cardFiscalRetryRequiresRecovery = true;
                    fiscalError = "Η συναλλαγή POS έχει ήδη εγκριθεί, αλλά η παλιά έκδοση συνέδεσε την υπογραφή Parochos με διαφορετικό αναγνωριστικό παραστατικού. Δεν έγινε νέα χρέωση. Χρειάζεται ανάκτηση της αρχικής υπογραφής από τα στοιχεία Parochos.";
                    closeStep = 2;
                    return;
                }
            }

            if (o.PaymentMethod == PaymentMethod.Card && !cardPaymentReady)







            {







                if (SelectedCardPosSetting is null) { fiscalError = "Επίλεξε ενεργό συνδεδεμένο POS."; return; }
            var preparation = await Fiscal.PrepareCardPaymentAsync(db, o, kind, SelectedCardPosSetting);







                if (!preparation.Success)







                {







                    fiscalError = preparation.ErrorMessage;







                    closeStep = 2;







                    return;







                }















                pendingCardPayment = preparation;
                edpsRetryWithFreshProviderData = false;
                edpsStatusCheckRequired = false;







                pendingCardDocumentKind = kind;







                pendingCardTerminalId = preparation.TerminalId;







                pendingCardAmount = preparation.Amount;







                cardTransactionId = "";







                await db.SaveChangesAsync();







                closeStep = 6;







                return;







            }















            if (o.PaymentMethod == PaymentMethod.Card)







                o.CardTransactionId = cardTransactionId.Trim();















            var result = await Fiscal.IssueAsync(db, o, kind, o.PaymentMethod == PaymentMethod.Card ? cardTransactionId : null);







            await db.SaveChangesAsync();















            if (!result.Success)







            {







                if (o.PaymentMethod == PaymentMethod.Card && cardPaymentReady &&
                    !string.IsNullOrWhiteSpace(o.CardTransactionId))
                {
                    cardFiscalRetryOnly = true;
                    cardFiscalRetryRequiresRecovery = result.RequiresRecovery;
                    pendingCardDocumentKind = kind;
                }

                fiscalError = result.RequiresRecovery
                    ? result.ErrorMessage
                    : $"Απέτυχε η έκδοση παραστατικού: {result.ErrorMessage} — Το τραπέζι ΔΕΝ έκλεισε, δοκίμασε ξανά.";







                closeStep = 2;







                return;







            }















            o.Status = OrderStatus.Closed;







            o.ClosedAt = DateTime.Now;







            await db.SaveChangesAsync();















            // Τύπωσε το τελικό φορολογικό παραστατικό με MARK και πραγματικό QR ESC/POS.







            // Δεν βάζουμε MARK μέσα στις γραμμές των προϊόντων.







            try







            {







                var fiscalItems = o.Items.Where(oi => !oi.IsCancelled).Select(oi => (







                    ItemName: oi.MenuItem!.Name,







                    Quantity: oi.Quantity,







                    LineTotal: oi.Quantity * ((oi.MenuItem?.Price ?? 0) + oi.ExtrasPrice),







                    VatPercent: oi.MenuItem?.VatPercentOverride ?? oi.MenuItem?.MenuCategory?.VatPercent ?? 24m)).ToList();







                var fiscalTotal = fiscalItems.Sum(i => i.LineTotal);















                var stations = o.Items.Where(oi => !oi.IsCancelled)
                    .SelectMany(oi => GetCategoryPrinters(oi.MenuItem?.MenuCategory))
                    .DistinctBy(s => s.Id)
                    .ToList();















                var waiterUser = await db.Users.FindAsync(currentUserId);







                foreach (var station in stations)







                {







                    var printed = await Printer.PrintFiscalReceiptAsync(







                        station,







                        tableName,







                        waiterUser?.FullName ?? "-",







                        kind == FiscalDocumentKind.Invoice ? "ΤΙΜΟΛΟΓΙΟ" : "ΑΠΟΔΕΙΞΗ ΛΙΑΝΙΚΗΣ",







                        o.InvoiceSeriesName ?? "",







                        o.InvoiceNumber ?? 0,







                        o.ParochosMark,







                        o.ParochosQrCode,







                        fiscalItems,







                        fiscalTotal,







                        companySettings,







                        kind == FiscalDocumentKind.Invoice ? o : null);















                    if (!printed)







                        Console.WriteLine($"⚠ Fiscal receipt printer failed: {station.Name} ({station.IpAddress}:{station.Port})");







                }







            }







            catch (Exception ex)







            {







                Console.WriteLine($"⚠ Fiscal receipt printing failed: {ex.Message}");







                // Η φορολογική έκδοση έχει ήδη ολοκληρωθεί. Η φυσική εκτύπωση είναι best-effort.







            }















            pendingCardPayment = null;







            cardTransactionId = "";







            pendingCardTerminalId = "";







            pendingCardAmount = 0m;







            pendingCardDocumentKind = FiscalDocumentKind.Receipt;















            lastDocumentLabel = kind == FiscalDocumentKind.Invoice ? "Τιμολόγιο" : "Απόδειξη";







            lastSeriesAndNumber = $"{o.InvoiceSeriesName}-{o.InvoiceNumber}";







            lastMark = o.ParochosMark;







            lastPdfUrl = o.ParochosPdfUrl;







            closeStep = 5;







        }







        catch (Exception ex)







        {







            fiscalError = $"Απρόσμενο σφάλμα: {ex.Message} — Το τραπέζι ΔΕΝ έκλεισε, δοκίμασε ξανά.";







            closeStep = 2;







        }







    }















    private void FinishClosing()







    {







        showPaymentModal = false;







        Nav.NavigateTo("/waiter");







    }
}
