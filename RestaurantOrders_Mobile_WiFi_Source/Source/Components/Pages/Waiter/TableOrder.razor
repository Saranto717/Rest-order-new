@page "/waiter/table/{TableId:int}"
@attribute [Authorize(Roles = "Waiter,Admin")]
@rendermode InteractiveServer
@using System.Security.Claims
@using System.Text.Json
@inject IDbContextFactory<AppDbContext> DbFactory
@inject PrinterService Printer
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject FiscalDocumentService Fiscal
@inject TableTransferService Transfers
@inject EpayWebEcrService Epay
@inject MellonWebEcrService Mellon
@inject EdpsWebEcrService Edps
@inject VivaCloudTerminalService Viva
@inject AadeRegistryService AadeRegistry

<style>
    .table-transfer-box { width:min(95vw,520px); max-width:520px; max-height:90dvh; overflow-y:auto; }
    .table-transfer-box select { width:100%; padding:10px; margin:12px 0; }
    .table-transfer-box button { margin:8px 0; }
    /* Back to tables: keep the framed button look, not a default/visited hyperlink. */
    button.nav-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 10px 16px;
        border: 1px solid #d5dbe6;
        border-radius: 12px;
        background: #fff;
        color: #1f2a44;
        font-weight: 700;
        text-decoration: none;
        box-sizing: border-box;
        -webkit-tap-highlight-color: transparent;
    }
    button.nav-button:active { background: #eef2f8; }

    /* Tap to add one; horizontal swipe is handled by pointer events. */
    .order-list li.order-item-interactive {
        cursor: pointer;
        touch-action: pan-y;
        user-select: none;
        -webkit-user-select: none;
        -webkit-tap-highlight-color: transparent;
    }
    .order-list li.order-item-interactive > span { pointer-events: none; }
    .order-list li.order-item-interactive .remove-btn { touch-action: manipulation; }
    .order-list li.order-item-interactive.pending { cursor: pointer; }
    .order-list li.order-item-interactive.printed { cursor: default; }
    /* Invoice modal - component local so it cannot be broken by global modal/input styles */
    .pin-box.invoice-pin-box {
        width: min(620px, calc(100vw - 32px));
        max-height: min(88vh, 760px);
        overflow-y: auto;
        padding: 28px;
        text-align: left;
        box-sizing: border-box;
    }

    .invoice-pin-box .invoice-form {
        width: 100%;
        color: #202736;
    }

    .invoice-pin-box .invoice-form-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 22px;
        padding-bottom: 18px;
        border-bottom: 1px solid #e6e9ef;
    }

    .invoice-pin-box .invoice-form-icon {
        width: 46px;
        height: 46px;
        flex: 0 0 46px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: #eef3ff;
        color: #1f2a44;
        font-size: 21px;
    }

    .invoice-pin-box .invoice-form-header h3 {
        margin: 0 0 4px;
        color: #1f2a44;
        font-size: 1.2rem;
        line-height: 1.2;
        text-align: left;
    }

    .invoice-pin-box .invoice-form-header p {
        margin: 0;
        color: #70798a;
        font-size: .86rem;
        line-height: 1.45;
        text-align: left;
    }

    .invoice-pin-box .invoice-field {
        margin-bottom: 14px;
    }

        .invoice-pin-box .invoice-field label {
            display: block;
            margin: 0 0 6px;
            color: #444d5e;
            font-size: .79rem;
            font-weight: 700;
            text-align: left;
        }

            .invoice-pin-box .invoice-field label span {
                color: #c0392b;
            }

    .invoice-pin-box .invoice-input,
    .invoice-pin-box .vat-lookup-row input {
        display: block;
        width: 100%;
        min-height: 44px;
        box-sizing: border-box;
        margin: 0;
        padding: 10px 13px;
        border: 1px solid #d2d7e0;
        border-radius: 10px;
        background: #fff;
        color: #202736;
        font: inherit;
        font-size: .93rem;
        outline: none;
        transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
    }

        .invoice-pin-box .invoice-input::placeholder,
        .invoice-pin-box .vat-lookup-row input::placeholder {
            color: #a0a7b4;
        }

        .invoice-pin-box .invoice-input:focus,
        .invoice-pin-box .vat-lookup-row input:focus {
            border-color: #7184b6;
            box-shadow: 0 0 0 3px rgba(31,42,68,.08);
        }

    .invoice-pin-box .vat-lookup-row {
        display: flex;
        align-items: stretch;
        gap: 9px;
    }

        .invoice-pin-box .vat-lookup-row input {
            flex: 1 1 auto;
        }

    .invoice-pin-box .vat-search-btn {
        width: 46px;
        min-width: 46px;
        min-height: 44px;
        padding: 0;
        border: 1px solid #c6ceda;
        border-radius: 10px;
        background: #f5f7fb;
        color: #1f2a44;
        cursor: pointer;
        font-size: 19px;
        display: grid;
        place-items: center;
        transition: all .15s ease;
    }

        .invoice-pin-box .vat-search-btn:hover:not(:disabled) {
            background: #eef3ff;
            border-color: #8798ba;
            transform: translateY(-1px);
        }

        .invoice-pin-box .vat-search-btn:disabled {
            cursor: wait;
            opacity: .65;
        }

    .invoice-pin-box .invoice-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 150px;
        gap: 0 12px;
    }

    .invoice-pin-box .invoice-field-full {
        grid-column: 1 / -1;
    }

    .invoice-pin-box .aade-status {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin-top: 12px;
        padding: 11px 13px;
        border-radius: 10px;
        font-size: .83rem;
        line-height: 1.45;
    }

        .invoice-pin-box .aade-status.loading {
            background: #f5f7fb;
            border: 1px solid #e0e4ec;
            color: #60697a;
        }

        .invoice-pin-box .aade-status.error-status {
            background: #fff5f3;
            border: 1px solid #f0c8c0;
            color: #9e3528;
        }

    .invoice-pin-box .aade-customer-info {
        margin-top: 14px;
        padding: 14px;
        border: 1px solid #d7e2f5;
        border-radius: 11px;
        background: #f5f8ff;
    }

    .invoice-pin-box .aade-info-title {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 11px;
        color: #315d92;
        font-size: .81rem;
        font-weight: 800;
    }

    .invoice-pin-box .aade-info-grid {
        display: grid;
        gap: 10px;
    }

        .invoice-pin-box .aade-info-grid > div span {
            display: block;
            margin-bottom: 2px;
            color: #7a8492;
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .03em;
        }

        .invoice-pin-box .aade-info-grid > div strong {
            display: block;
            color: #283244;
            font-size: .84rem;
            line-height: 1.35;
            overflow-wrap: anywhere;
        }

    .invoice-pin-box .invoice-actions {
        display: flex;
        flex-direction: column;
        gap: 9px;
        margin-top: 20px;
    }

    .invoice-pin-box .invoice-submit-btn {
        width: 100%;
        min-height: 46px;
        padding: 10px 15px;
        border: 0;
        border-radius: 10px;
        background: #1f2a44;
        color: #fff;
        font-size: .93rem;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(31,42,68,.17);
        transition: all .15s ease;
    }

        .invoice-pin-box .invoice-submit-btn:hover {
            background: #172137;
            transform: translateY(-1px);
        }

    .invoice-pin-box .invoice-back-btn {
        align-self: center;
        margin-top: 1px;
    }

    @@media (max-width: 560px) {
        .pin-box.invoice-pin-box {
            width: calc(100vw - 20px);
            padding: 20px;
        }

        .invoice-pin-box .invoice-grid {
            grid-template-columns: 1fr;
        }
    }

    .send-btn.sending,
    .send-btn:disabled.sending {
        background: #a9a9a9 !important;
        color: #ffffff !important;
        cursor: not-allowed;
        opacity: 1;
    }

        .send-btn.sending:hover,
        .send-btn:disabled.sending:hover {
            background: #a9a9a9 !important;
            transform: none;
        }

    .table-order-page {
        width: 100vw;
        min-height: calc(100vh - 70px);
        margin-left: calc(50% - 50vw);
        padding: 18px;
        box-sizing: border-box;
        background: var(--order-page-bg, #f4f6f9);
        position: relative;
    }

    .order-background-menu {
        position: fixed;
        z-index: 6000;
        width: 280px;
        background: #fff;
        border: 1px solid #d8dde6;
        border-radius: 14px;
        padding: 16px;
        box-shadow: 0 12px 35px rgba(0,0,0,.22);
    }

        .order-background-menu h4 {
            margin: 0 0 12px;
        }

    .order-background-field {
        margin: 10px 0;
    }

        .order-background-field label {
            display: block;
            font-size: .82rem;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .order-background-field input[type=color] {
            width: 100%;
            height: 44px;
            border: 1px solid #ccd2dc;
            border-radius: 9px;
            padding: 3px;
            cursor: pointer;
        }

    .order-background-actions {
        display: flex;
        gap: 8px;
        margin-top: 14px;
    }

        .order-background-actions button {
            flex: 1;
            min-height: 42px;
            border: 0;
            border-radius: 9px;
            font-weight: 700;
            cursor: pointer;
        }

    .order-background-reset {
        background: #eef1f5;
        color: #263246;
    }

    .order-background-save {
        background: #1f2a44;
        color: #fff;
    }


    /* POS layout: categories left, products center, order right */
    html, body {
        overflow-x: hidden;
    }

    .table-order-page {
        width: 100vw;
        max-width: 100vw;
        min-height: calc(100dvh - 52px);
        margin-left: calc(50% - 50vw);
        padding: 18px;
        box-sizing: border-box;
        overflow-x: hidden;
    }

    .order-layout {
        display: grid !important;
        grid-template-columns: minmax(190px, min(var(--category-panel-width, 190px), calc(100vw - 380px))) minmax(0, 1fr) 330px !important;
        gap: 14px;
        align-items: start;
    }

    .category-panel {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        background: rgba(255,255,255,.94);
        border-radius: 12px;
        padding: 10px;
        box-sizing: border-box;
        position: sticky;
        top: 12px;
        overflow: hidden;
    }

    .category-panel-title {
        margin: 2px 6px 9px;
        font-size: .82rem;
        font-weight: 800;
        color: #586174;
        text-transform: uppercase;
    }

    .category-list {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .category-choice {
        box-sizing: border-box;
        max-width: 100%;
        min-height: 48px;
        padding: 10px 12px;
        border: 1px solid #d7dce5;
        border-radius: 9px;
        background: #fff;
        color: #202736;
        font: inherit;
        font-weight: 800;
        text-align: left;
        cursor: pointer;
        transition: .15s ease;
    }

        .category-choice:hover {
            border-color: #1f2a44;
        }

        .category-choice.active {
            background: #1f2a44;
            color: #fff;
            border-color: #1f2a44;
        }

    .products-panel {
        min-width: 0;
    }

    .products-panel-header {
        margin: 0 0 10px;
        padding: 10px 12px;
        background: rgba(255,255,255,.94);
        border-radius: 10px;
        font-weight: 800;
        color: #202736;
    }

    .products-panel .item-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(145px, 1fr));
        gap: 10px;
        margin: 0;
    }

    .products-panel .menu-item-btn {
        min-height: 82px;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 12px 8px;
    }

    /* Extras open as a dedicated full-screen tab, using the same tiles as menu products. */
    .extras-screen-overlay {
        position: fixed;
        inset: 0;
        z-index: 10000;
        display: flex;
        align-items: stretch;
        justify-content: stretch;
        padding: 14px;
        background: #f2f4f8;
        overflow: auto;
        box-sizing: border-box;
    }

    .extras-screen-box {
        width: 100%;
        min-height: 100%;
        max-height: none;
        overflow: auto;
        margin: 0;
        padding: 18px;
        border-radius: 12px;
        background: #f2f4f8;
        color: #202736;
        box-sizing: border-box;
        text-align: left;
    }

    .extras-screen-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 14px;
        padding: 4px 0 14px;
        border-bottom: 1px solid #d5dbe5;
    }

    .extras-screen-header h3 {
        margin: 0;
        font-size: 1.35rem;
        color: #202736;
    }

    .extras-screen-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(145px, 1fr));
        gap: 10px;
        margin: 14px 0;
    }

    .extras-screen-grid .menu-item-btn {
        min-height: 82px;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 12px 8px;
        background: #fff;
        color: #202736;
        border: 1px solid #d5dbe5;
        border-radius: 10px;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
    }

    .extras-screen-grid .menu-item-btn.selected {
        background: #1f2a44;
        border-color: #1f2a44;
        color: #fff;
    }

    .extras-screen-grid .menu-item-btn .price {
        font-weight: 800;
    }

    .extras-screen-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid #d5dbe5;
    }

    .extra-option-btn {
        min-height: 82px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 7px;
        padding: 12px 8px;
        border: 1px solid #d5dbe5;
        border-radius: 10px;
        background: #fff;
        color: #202736;
        font: inherit;
        font-weight: 700;
        text-align: center;
        cursor: pointer;
        transition: .15s ease;
    }

    .extra-option-btn:hover {
        border-color: #1f2a44;
    }

    .extra-option-btn.selected {
        background: #1f2a44;
        border-color: #1f2a44;
        color: #fff;
    }

    .extra-option-btn .price {
        font-weight: 800;
    }

    .order-panel {
        min-width: 0;
        max-height: calc(100dvh - 110px);
        overflow-y: auto;
    }

    @@media (max-width: 1050px) {
        .order-layout {
            grid-template-columns: minmax(165px, min(var(--category-panel-width, 165px), calc(100vw - 340px))) minmax(0, 1fr) 300px !important;
        }
    }

    @@media (max-width: 820px) {
        .order-layout {
            grid-template-columns: 1fr !important;
        }

        .category-panel {
            position: static;
        }

        .category-list {
            flex-direction: row;
            flex-wrap: wrap;
        }

        .category-choice {
            width: auto;
            min-width: 130px;
        }

        .order-panel {
            max-height: none;
        }
    }


    .category-customization-menu {
        position: fixed;
        z-index: 10050;
        width: 300px;
        max-width: calc(100vw - 20px);
        background: #fff;
        border: 1px solid #d8dde7;
        border-radius: 12px;
        box-shadow: 0 12px 32px rgba(0,0,0,.22);
        padding: 14px;
        color: #202736;
    }

        .category-customization-menu h4 {
            margin: 0 0 12px;
            font-size: 1rem;
        }

    .category-customization-field {
        margin-bottom: 10px;
    }

        .category-customization-field label {
            display: block;
            margin-bottom: 5px;
            font-size: .75rem;
            font-weight: 800;
            color: #626b7a;
        }

        .category-customization-field input[type="color"] {
            width: 100%;
            height: 38px;
            padding: 2px;
        }

        .category-customization-field input[type="number"] {
            width: 100%;
            box-sizing: border-box;
            min-height: 34px;
        }

    .category-customization-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .category-customization-actions {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }

        .category-customization-actions button {
            flex: 1;
            min-height: 38px;
            border: 0;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 800;
        }

    .category-customization-save {
        background: #1f2a44;
        color: #fff;
    }

    .category-customization-reset {
        background: #eceef2;
        color: #202736;
    }

    .category-customization-bold {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 34px;
        font-size: .82rem;
        font-weight: 700;
    }

    .action-button-customization-menu {
        position: fixed;
        z-index: 10060;
        width: 310px;
        max-width: calc(100vw - 20px);
        background: #ffffff;
        border: 1px solid #d8dde7;
        border-radius: 14px;
        box-shadow: 0 14px 38px rgba(31,42,68,.24);
        padding: 15px;
        color: #202736;
    }

    .action-button-customization-menu h4 {
        margin: 0 0 5px;
        font-size: 1rem;
        color: #263b59;
    }

    .action-button-customization-caption {
        margin: 0 0 14px;
        color: #70798a;
        font-size: .82rem;
    }

    .action-button-customization-menu input[type="color"] {
        width: 100%;
        height: 38px;
        padding: 2px;
        border: 1px solid #d5dce7;
        border-radius: 8px;
        background: #fff;
        cursor: pointer;
    }

    .order-action-btn {
        border-width: 1px !important;
        font-weight: 700;
        box-shadow: 0 2px 6px rgba(31,42,68,.07);
        transition: transform .15s ease, box-shadow .15s ease, filter .15s ease;
    }

    .order-action-btn:hover {
        filter: brightness(.97);
        transform: translateY(-1px);
        box-shadow: 0 5px 12px rgba(31,42,68,.12);
    }

    .order-action-btn:active {
        transform: translateY(0);
    }

    .action-button-color-hint {
        margin: 10px 0 0;
        font-size: .73rem;
        line-height: 1.35;
        color: #7b8492;
        text-align: center;
    }


    /* Final mobile overrides: this style block is emitted with the page, after app.css. */
    @@media (max-width: 680px) {
        .table-order-page {
            width: 100%;
            max-width: 100%;
            margin-left: 0;
            padding: 10px !important;
            overflow-x: clip;
        }

        .order-layout {
            grid-template-columns: minmax(0, 1fr) !important;
            gap: 10px;
        }

        .category-panel {
            position: static;
            padding: 9px;
        }

        .category-list {
            flex-direction: row;
            flex-wrap: nowrap;
            gap: 7px;
            overflow-x: auto;
            padding: 1px 1px 7px;
            -webkit-overflow-scrolling: touch;
        }

        .category-choice {
            flex: 0 0 auto;
            min-width: max-content;
            max-width: 78vw;
            min-height: 46px;
            text-align: center;
        }

        .order-panel {
            position: static !important;
            max-height: none !important;
            overflow: visible !important;
            margin-bottom: max(16px, env(safe-area-inset-bottom));
        }

        .products-panel .item-grid,
        .extras-screen-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
        }

        .products-panel .menu-item-btn,
        .extras-screen-grid .menu-item-btn {
            min-height: 76px;
            padding: 12px 8px;
            overflow-wrap: anywhere;
        }

        .order-panel .send-btn,
        .order-panel .close-btn,
        .order-panel .order-action-btn {
            min-height: 48px;
        }

        .pin-overlay {
            align-items: flex-start;
            overflow-y: auto;
            padding: max(12px, env(safe-area-inset-top)) 10px max(12px, env(safe-area-inset-bottom));
        }

        .pin-box {
            width: 100%;
            max-width: 520px;
            max-height: none;
            margin: auto;
            padding: 20px 16px;
            box-sizing: border-box;
        }

        .extras-screen-overlay {
            padding: max(8px, env(safe-area-inset-top)) 8px max(8px, env(safe-area-inset-bottom));
        }

        .extras-screen-box {
            padding: 12px;
        }
    }

</style>

<div class="table-order-page" style="--order-page-bg:@pageBackground" @onclick="CloseCustomizationMenus" @oncontextmenu="OpenOrderBackgroundMenu" @oncontextmenu:preventDefault="true">

    @if (showOrderBackgroundMenu)
    {
        <div class="order-background-menu" style="left:@(orderBackgroundMenuX)px; top:@(orderBackgroundMenuY)px" @onclick:stopPropagation="true">
            <h4>🎨 Φόντο τραπεζιού</h4>
            <div class="order-background-field">
                <label>Χρώμα φόντου</label>
                <input type="color" @bind="editingPageBackground" />
            </div>
            <div class="order-background-actions">
                <button class="order-background-reset" @onclick="ResetOrderBackground">Επαναφορά στο φόντο τραπεζιών</button>
                <button class="order-background-save" @onclick="SaveOrderBackground">Αποθήκευση</button>
            </div>
        </div>
    }

    @if (showCategoryCustomizationMenu)
    {
        <div class="category-customization-menu"
             style="left:@(categoryCustomizationX)px; top:@(categoryCustomizationY)px"
             @onclick:stopPropagation="true">
            <h4>🎨 Μορφοποίηση κατηγορίας</h4>

            <div class="category-customization-field">
                <label>Γέμισμα</label>
                <input type="color" @bind="editingCategoryStyle.Background" />
            </div>

            <div class="category-customization-row">
                <div class="category-customization-field">
                    <label>Χρώμα κειμένου</label>
                    <input type="color" @bind="editingCategoryStyle.TextColor" />
                </div>
                <div class="category-customization-field">
                    <label>Χρώμα περιγράμματος</label>
                    <input type="color" @bind="editingCategoryStyle.BorderColor" />
                </div>
            </div>

            <div class="category-customization-row">
                <div class="category-customization-field">
                    <label>Πλάτος (px)</label>
                    <input type="number" min="80" max="500" @bind="editingCategoryStyle.Width" />
                </div>
                <div class="category-customization-field">
                    <label>Ύψος (px)</label>
                    <input type="number" min="32" max="180" @bind="editingCategoryStyle.Height" />
                </div>
            </div>

            <div class="category-customization-field">
                <label>Μέγεθος γραμματοσειράς (px)</label>
                <input type="number" min="10" max="40" @bind="editingCategoryStyle.FontSize" />
            </div>

            <label class="category-customization-bold">
                <input type="checkbox" @bind="editingCategoryStyle.Bold" />
                Έντονα γράμματα
            </label>

            <div class="category-customization-actions">
                <button class="category-customization-reset" @onclick="ResetCategoryCustomization">Επαναφορά</button>
                <button class="category-customization-save" @onclick="SaveCategoryCustomization">Αποθήκευση</button>
            </div>
        </div>
    }

    @if (showActionButtonCustomizationMenu)
    {
        <div class="action-button-customization-menu"
             style="left:@(actionCustomizationX)px; top:@(actionCustomizationY)px"
             @onclick:stopPropagation="true">
            <h4>🎨 Χρώματα κουμπιού</h4>
            <p class="action-button-customization-caption">@GetActionButtonDisplayName(editingActionButtonKey)</p>

            <div class="category-customization-field">
                <label>Χρώμα φόντου</label>
                <input type="color" @bind="editingActionButtonStyle.Background" />
            </div>
            <div class="category-customization-field">
                <label>Χρώμα κειμένου</label>
                <input type="color" @bind="editingActionButtonStyle.TextColor" />
            </div>
            <div class="category-customization-field">
                <label>Χρώμα περιγράμματος</label>
                <input type="color" @bind="editingActionButtonStyle.BorderColor" />
            </div>

            <div class="category-customization-actions">
                <button class="category-customization-reset" @onclick="ResetActionButtonCustomization">Προεπιλογή</button>
                <button class="category-customization-save" @onclick="SaveActionButtonCustomization">Αποθήκευση</button>
            </div>
        </div>
    }

    <button type="button" class="nav-button" @onclick='() => Nav.NavigateTo("/waiter", forceLoad: true)'>&larr; Πίσω στα τραπέζια</button>
    <h2>@tableName</h2>

    <div class="order-layout">
        <div class="category-panel">
            <div class="category-panel-title">Κατηγορίες</div>
            <div class="category-list">
                @if (categories.Count == 0)
                {
                    <span class="hint">Δεν υπάρχουν ενεργές κατηγορίες. Ενεργοποίησε μία από τη Διαχείριση → Κατηγορίες.</span>
                }
                @foreach (var cat in categories)
                {
                    <button class="category-choice @(selectedCategoryId == cat.Id ? "active" : "")"
                            style="@GetCategoryStyle(cat.Id)"
                            @onclick="() => SelectCategory(cat.Id)"
                            @oncontextmenu="(e) => OpenCategoryCustomization(cat.Id, e)"
                            @oncontextmenu:preventDefault="true"
                            @oncontextmenu:stopPropagation="true">
                        @cat.Name
                    </button>
                }
            </div>
        </div>

        <div class="products-panel">
            @if (selectedCategoryId != 0 && itemsByCategory.TryGetValue(selectedCategoryId, out var selectedCategoryItems))
            {
                var selectedCategory = categories.FirstOrDefault(c => c.Id == selectedCategoryId);
                <div class="products-panel-header">@(selectedCategory?.Name ?? "Προϊόντα")</div>
                <div class="item-grid">
                    @foreach (var item in selectedCategoryItems)
                    {
                        <button class="menu-item-btn"
                                @onclick="() => SelectItem(item)">
                            <span>@item.Name</span>
                            <span class="price">€@item.Price.ToString("0.00")</span>
                        </button>
                    }
                    @if (selectedCategoryItems.Count == 0)
                    {
                        <span class="hint">Δεν έχουν προστεθεί είδη σε αυτή την κατηγορία.</span>
                    }
                </div>
            }
            else
            {
                <div class="products-panel-header">Επίλεξε κατηγορία</div>
            }
        </div>

        <div class="order-panel">
            <h3>Παραγγελία</h3>
            <ul class="order-list">
                @foreach (var oi in order.Items.Where(i => !i.IsCancelled && RemainingQuantityForItem(i) > 0).OrderBy(i => i.Id))
                {
                    <li class="order-item-interactive @(oi.IsPrinted ? "printed" : "pending")"
                        @onpointerdown="(e) => OrderItemPointerDown(oi, e)"
                        @onpointerup="(e) => OrderItemPointerUp(oi, e)"
                        @onclick="() => HandleOrderItemTap(oi)">
                        <span>
                            @RemainingQuantityForItem(oi) x @oi.MenuItem!.Name
                            @if (oi.ExtrasPrice > 0)







                            {
                                <text> (+€@oi.ExtrasPrice.ToString("0.00"))</text>
                            }
                            @if (!string.IsNullOrWhiteSpace(oi.Notes))







                            {
                                <br />

                                <small>@oi.Notes</small>
                            }
                        </span>
                        <button class="remove-btn"
                                title="Αφαίρεση είδους"
                                @onclick="() => RemoveItemFromPendingOrder(oi)"
                                @onclick:stopPropagation="true">
                            ✕
                        </button>
                        @if (oi.IsPrinted)
                        {
                            <span class="sent-tag">απεστάλη</span>
                        }
                    </li>
                }
            </ul>

            <p class="total"><strong>Σύνολο: €@CurrentOrderTotal.ToString("0.00")</strong></p>

            <button class="send-btn @(sendingToKitchen ? "sending" : "")"
                    disabled="@(sendingToKitchen || !order.Items.Any(i => !i.IsPrinted && !i.IsCancelled))"
                    @onclick="SendToKitchen">
                @(sendingToKitchen ? "Αποστολή..." : "Αποστολή στην κουζίνα/μπαρ")
            </button>

            <button class="close-btn order-action-btn" style='@GetActionButtonStyle("reprint")'
                    title="Δεξί κλικ για αλλαγή χρώματος"
                    @oncontextmenu='(e) => OpenActionButtonCustomization("reprint", e)'
                    @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true"
                    @onclick="ReprintOrder">Επανεκτύπωση παραγγελίας</button>
            <button class="close-btn order-action-btn" style='@GetActionButtonStyle("bill")'
                    title="Δεξί κλικ για αλλαγή χρώματος"
                    @oncontextmenu='(e) => OpenActionButtonCustomization("bill", e)'
                    @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true"
                    @onclick="PrintBill">Λογαριασμός</button>
            <button class="close-btn order-action-btn" style='@GetActionButtonStyle("cancel")'
                    title="Δεξί κλικ για αλλαγή χρώματος"
                    @oncontextmenu='(e) => OpenActionButtonCustomization("cancel", e)'
                    @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true"
                    @onclick="BeginCancelWholeOrder">Ακύρωση παραγγελίας</button>
            <button class="close-btn order-action-btn" style='@GetActionButtonStyle("close")'
                    title="Δεξί κλικ για αλλαγή χρώματος"
                    @oncontextmenu='(e) => OpenActionButtonCustomization("close", e)'
                    @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true"
                    @onclick="() => { showPaymentModal = true; closeStep = 1; }">Κλείσιμο τραπεζιού</button>
            <button class="close-btn order-action-btn" disabled="@(sendingToKitchen || epayBusy || cancellationInProgress || wholeOrderCancellationInProgress || tableTransferBusy)"
                    @onclick="BeginTableTransfer">Μεταφορά όλων σε άλλο τραπέζι</button>
            <p class="action-button-color-hint">🎨 Δεξί κλικ σε ένα από τα παραπάνω κουμπιά για να αλλάξεις τα χρώματά του.</p>

            @if (showPaymentModal)







            {
                <div class="pin-overlay">
                    <div class="pin-box @(closeStep == 3 ? "invoice-pin-box" : "")">
                        @if (closeStep == 1)
                        {
                            <h3>Τρόπος πληρωμής</h3>
                            <p class="hint">Τραπέζι: @tableName</p>
                            <div class="payment-choice">
                                <button class="pay-btn cash" @onclick="() => SelectPayment(PaymentMethod.Cash)">💵 Μετρητά — όλο το τραπέζι</button>
                                <button class="pay-btn card" @onclick="() => SelectPayment(PaymentMethod.Card)">💳 Κάρτα — όλο το τραπέζι</button>
                            </div>
                            <button class="close-btn" @onclick="BeginSplitPayment">➗ Μερική / Split πληρωμή</button>
                            <button class="linkbtn-plain" @onclick="() => showPaymentModal = false">Άκυρο</button>
                        }
                        else if (closeStep == 2)
                        {
                            <h3>Παραστατικό</h3>
                            @if (cardFiscalRetryOnly)
                            {
                                <p class="error">Η συναλλαγή κάρτας έχει ήδη εγκριθεί. Δεν θα σταλεί ξανά ποσό στο POS.</p>
                                @if (!string.IsNullOrEmpty(fiscalError)) { <p class="error">@fiscalError</p> }
                                @if (!cardFiscalRetryRequiresRecovery)
                                {
                                    <button class="pay-btn card" @onclick="RetryApprovedCardFiscalDocument">🧾 Επανάληψη έκδοσης @((pendingCardDocumentKind == FiscalDocumentKind.Invoice) ? "τιμολογίου" : "απόδειξης")</button>
                                }
                            }
                            @if (!cardFiscalRetryOnly)
                            {
                            @if (selectedPaymentMethod == PaymentMethod.Card && cardPosSettings.Count > 0)
                            {
                                <label>Τερματικό κάρτας</label>
                                <select class="form-select" @bind="selectedCardPosSettingsId" @bind:after="CardPosChanged">
                                    @foreach (var pos in cardPosSettings)
                                    {
                                        <option value="@pos.Id">@pos.Name — @pos.Provider — TID @pos.TerminalId — @(pos.UseProduction ? "Παραγωγικό" : "Demo")</option>
                                    }
                                </select>
                            }
                            @if (!string.IsNullOrEmpty(fiscalError))







                            {
                                <p class="error">@fiscalError</p>
                            }
                            <div class="payment-choice">
                                <button class="pay-btn cash" @onclick="() => SelectDocumentKind(FiscalDocumentKind.Receipt)">🧾 Απόδειξη</button>
                                <button class="pay-btn card" @onclick="() => SelectDocumentKind(FiscalDocumentKind.Invoice)">📄 Τιμολόγιο</button>
                            </div>
                            }
                            <button class="linkbtn-plain" @onclick="() => closeStep = 1">&larr; Πίσω</button>
                        }
                        else if (closeStep == 3)
                        {
                            <div class="invoice-form">
                                <div class="invoice-form-header">
                                    <div class="invoice-form-icon">📄</div>
                                    <div>
                                        <h3>Στοιχεία Τιμολόγησης</h3>
                                        <p>Αναζήτησε τον πελάτη με το ΑΦΜ του και τα στοιχεία θα συμπληρωθούν αυτόματα.</p>
                                    </div>
                                </div>

                                <div class="invoice-field">
                                    <label for="counterpart-vat">ΑΦΜ πελάτη <span>*</span></label>
                                    <div class="vat-lookup-row">
                                        <input id="counterpart-vat"
                                               class="invoice-input"
                                               value="@counterpartVat"
                                               @oninput="OnCounterpartVatInput"
                                               maxlength="9"
                                               inputmode="numeric"
                                               autocomplete="off"
                                               placeholder="9 ψηφία" />

                                        @if (NormalizedCounterpartVat.Length == 9)







                                        {
                                            <button type="button"
                                                    class="vat-search-btn"
                                                    title="Αναζήτηση στοιχείων ΑΑΔΕ"
                                                    disabled="@aadeLookupInProgress"
                                                    @onclick="LookupCustomerByVatAsync">
                                                @(aadeLookupInProgress ? "⏳" : "🔎")
                                            </button>
                                        }
                                    </div>
                                </div>

                                <div class="invoice-grid">
                                    <div class="invoice-field invoice-field-full">
                                        <label for="counterpart-name">Επωνυμία <span>*</span></label>
                                        <input id="counterpart-name" class="invoice-input" @bind="counterpartName" placeholder="Επωνυμία επιχείρησης" />
                                    </div>

                                    <div class="invoice-field invoice-field-full">
                                        <label for="counterpart-street">Διεύθυνση</label>
                                        <input id="counterpart-street" class="invoice-input" @bind="counterpartStreet" placeholder="Οδός και αριθμός" />
                                    </div>

                                    <div class="invoice-field">
                                        <label for="counterpart-city">Πόλη</label>
                                        <input id="counterpart-city" class="invoice-input" @bind="counterpartCity" placeholder="Πόλη" />
                                    </div>

                                    <div class="invoice-field">
                                        <label for="counterpart-postal">Τ.Κ.</label>
                                        <input id="counterpart-postal" class="invoice-input" @bind="counterpartPostalCode" placeholder="Τ.Κ." inputmode="numeric" />
                                    </div>
                                </div>

                                @if (aadeLookupInProgress)
                                {
                                    <div class="aade-status loading">
                                        <span>⏳</span> Γίνεται αναζήτηση στοιχείων στην ΑΑΔΕ...
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(aadeLookupError))
                                {
                                    <div class="aade-status error-status">
                                        <span>⚠</span> @aadeLookupError
                                    </div>
                                }

                                @if (aadeCustomerFound)
                                {
                                    <div class="aade-customer-info">
                                        <div class="aade-info-title"><span>✓</span> Στοιχεία ανακτήθηκαν από ΑΑΔΕ</div>
                                        <div class="aade-info-grid">
                                            @if (!string.IsNullOrWhiteSpace(counterpartDoy))







                                            {
                                                <div><span>ΔΟΥ</span><strong>@counterpartDoy</strong></div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(counterpartMainActivity))







                                            {
                                                <div><span>Κύρια δραστηριότητα</span><strong>@counterpartMainActivity</strong></div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(counterpartLegalStatus))







                                            {
                                                <div><span>Νομική μορφή</span><strong>@counterpartLegalStatus</strong></div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(fiscalError))
                                {
                                    <div class="aade-status error-status">
                                        <span>⚠</span> @fiscalError
                                    </div>
                                }

                                <div class="invoice-actions">
                                    <button class="invoice-submit-btn" @onclick="ConfirmClose">
                                        <span>✓</span> Έκδοση Τιμολογίου & Κλείσιμο
                                    </button>
                                    <button class="linkbtn-plain invoice-back-btn" @onclick="() => closeStep = 2">&larr; Πίσω</button>
                                </div>
                            </div>
                        }
                        else if (closeStep == 4)
                        {
                            <h3>Έκδοση παραστατικού...</h3>
                            <p class="hint">Στέλνεται στην ΑΑΔΕ μέσω Parochos, περίμενε λίγο.</p>
                            @if (!string.IsNullOrEmpty(fiscalError))







                            {
                                <p class="error">@fiscalError</p>
                                <button @onclick="() => closeStep = 2">&larr; Πίσω</button>
                                <button class="linkbtn-plain" @onclick="() => showPaymentModal = false">Άκυρο</button>
                            }
                        }
                        else if (closeStep == 7)
                        {
                            <h3>➗ Split πληρωμή</h3>
                            <p class="hint">Επίλεξε πόσα τεμάχια θα πληρωθούν τώρα.</p>
                            @foreach (var item in splitPaymentItems)

                            {

                                var selectedQty = splitQuantities.TryGetValue(item.Id, out var q) ? q : 0;
                                <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid #eee;">
                                    <span>@item.MenuItem?.Name <small>(διαθέσιμα: @item.Quantity)</small></span>
                                    <input type="number" min="0" max="@item.Quantity" value="@selectedQty" style="width:80px;" @onchange="e => SetSplitQuantity(item.Id, e.Value?.ToString())" />
                                </div>
                            }
                            <p><strong>Πληρωμή τώρα: €@SplitSelectedTotal.ToString("0.00")</strong></p>
                            @if (!string.IsNullOrEmpty(fiscalError))
                            {
                                <p class="error">@fiscalError</p>
                            }
                            <button @onclick="ContinueSplitPayment">Συνέχεια</button>
                            <button class="linkbtn-plain" @onclick="() => closeStep = 1">&larr; Πίσω</button>
                        }
                        else if (closeStep == 8)
                        {
                            <h3>Τρόπος πληρωμής</h3>
                            <p class="hint">Ποσό: €@SplitSelectedTotal.ToString("0.00")</p>
                            <div class="payment-choice">
                                <button class="pay-btn cash" @onclick="() => SelectSplitPayment(PaymentMethod.Cash)">💵 Μετρητά</button>
                                <button class="pay-btn card" @onclick="() => SelectSplitPayment(PaymentMethod.Card)">💳 Κάρτα</button>
                            </div>
                            <button class="linkbtn-plain" @onclick="() => closeStep = 7">&larr; Πίσω</button>
                        }
                        else if (closeStep == 9)
                        {
                            <h3>Παραστατικό</h3>
                            @if (selectedPaymentMethod == PaymentMethod.Card && cardPosSettings.Count > 0)
                            {
                                <label>Τερματικό κάρτας</label>
                                <select class="form-select" @bind="selectedCardPosSettingsId" @bind:after="CardPosChanged">
                                    @foreach (var pos in cardPosSettings)
                                    {
                                        <option value="@pos.Id">@pos.Name — @pos.Provider — TID @pos.TerminalId — @(pos.UseProduction ? "Παραγωγικό" : "Demo")</option>
                                    }
                                </select>
                            }
                            @if (!string.IsNullOrEmpty(fiscalError))
                            {
                                <p class="error">@fiscalError</p>
                            }
                            <div class="payment-choice">
                                <button class="pay-btn cash" @onclick="() => IssueSelectedPayment(FiscalDocumentKind.Receipt)">🧾 Απόδειξη</button>
                                <button class="pay-btn card" @onclick="() => IssueSelectedPayment(FiscalDocumentKind.Invoice)">📄 Τιμολόγιο</button>
                            </div>
                            <button class="linkbtn-plain" @onclick="() => closeStep = 8">&larr; Πίσω</button>
                        }
                        else if (closeStep == 10)
                        {
                            @if (IsSelectedVivaCloud)
                            {
                                <h3>💳 Πληρωμή μέσω Viva Cloud Terminal</h3>
                                <p><strong>Ποσό:</strong> €@pendingCardAmount.ToString("0.00")</p>
                                <p class="hint">POS: @SelectedCardPosSetting?.Name — Terminal ID @SelectedCardPosSetting?.TerminalId</p>
                                <button @onclick="() => StartSelectedVivaPayment(true)" disabled="@epayBusy">@(epayBusy ? "Αναμονή αποτελέσματος Viva…" : !string.IsNullOrWhiteSpace(cardTransactionId) ? "🧾 Επανάληψη έκδοσης παραστατικού" : "💳 Αποστολή ποσού στο Viva POS")</button>
                                @if (vivaStatusCheckRequired) { <p class="error">Η προηγούμενη προσπάθεια έχει αβέβαιο αποτέλεσμα. Έλεγξε το ιστορικό Viva πριν από νέα προσπάθεια.</p><p class="hint">Session ID: @vivaPendingSessionId</p> }
                                @if (!string.IsNullOrEmpty(fiscalError)) { <p class="error">@fiscalError</p> }
                            }
                            else if (IsSelectedEdpsWebEcr)
                            {
                                <h3>💳 Πληρωμή μέσω EDPS Middleware</h3>
                                <p><strong>Ποσό:</strong> €@pendingCardAmount.ToString("0.00")</p>
                                <p class="hint">POS: @SelectedCardPosSetting?.Name — φυσικό TID @SelectedCardPosSetting?.TerminalId — Middleware route: @(string.IsNullOrWhiteSpace(SelectedCardPosSetting?.IdUrl) ? "/terminal/txninit" : SelectedCardPosSetting?.IdUrl)</p>
                                <button @onclick="StartEdpsSplitCardPayment" disabled="@epayBusy">@(epayBusy ? "Προετοιμασία / αναμονή EDPS…" : edpsRetryWithFreshProviderData ? "🔄 Νέα προσπάθεια (νέα υπογραφή)" : "💳 Αποστολή ποσού στο EDPS POS")</button>
                                @if (edpsStatusCheckRequired)
                                {
                                    <p class="error">Έλεγξε στο POS αν η προηγούμενη προσπάθεια χρεώθηκε. Αν επιβεβαιώσεις ότι απορρίφθηκε, πάτησε ξανά το ίδιο κουμπί για αυτόματη νέα υπογραφή και επανάληψη.</p>
                                }
                            }
                            else
                            {
                            <h3>💳 Πληρωμή με WebECR — @(SelectedCardPosSetting?.Provider ?? "ePay")</h3>
                            <p><strong>Ποσό:</strong> €@pendingCardAmount.ToString("0.00")</p>
                            @if (IsSelectedMellonWebEcr)
                            {
                                <p>POS: @SelectedCardPosSetting?.Name — @SelectedCardPosSetting?.Provider — TID @SelectedCardPosSetting?.TerminalId — @(SelectedCardPosSetting?.UseProduction == true ? "Παραγωγικό" : "Demo")</p>
                                <button @onclick="StartEpaySplitCardPayment" disabled="@epayBusy">@(epayBusy ? "Αναμονή απάντησης POS…" : !string.IsNullOrWhiteSpace(cardTransactionId) ? "🧾 Επανάληψη έκδοσης παραστατικού" : "💳 Αποστολή ποσού στο επιλεγμένο POS")</button>
                            }
                            else
                            {
                            <button @onclick="() => LoadEpayTerminals(true)" disabled="@epayBusy">@(epayBusy ? "Αναζήτηση διαθέσιμων POS…" : "🔄 Αναζήτηση διαθέσιμων POS")</button>
                            @if (epayTerminals.Count > 0)
                            {
                                <label>Επίλεξε POS</label>
                                <select class="form-select" @bind="selectedEpayBackendId">
                                    <option value="">-- Επιλογή POS --</option>
                                    @foreach (var t in epayTerminals)
                                    {
                                        <option value="@t.BackendId">TID @t.TerminalId — ID URL @t.BackendId — @t.Merchant @(!string.IsNullOrWhiteSpace(t.Acquirer) ? $"({t.Acquirer})" : "")</option>
                                    }
                                </select>
                                <button @onclick="StartEpaySplitCardPayment" disabled="@(epayBusy || string.IsNullOrWhiteSpace(selectedEpayBackendId))">@(epayBusy ? "Αναμονή απάντησης ePay…" : "💳 Αποστολή ποσού στο επιλεγμένο POS")</button>
                            }
                            }
                            @if (!string.IsNullOrEmpty(fiscalError)) { <p class="error">@fiscalError</p> }
                            }
                            <button class="linkbtn-plain" @onclick="() => closeStep = 8">&larr; Πίσω</button>
                        }
                        else if (closeStep == 6)
                        {
                            @if (IsSelectedVivaCloud)
                            {
                                <h3>💳 Πληρωμή μέσω Viva Cloud Terminal</h3>
